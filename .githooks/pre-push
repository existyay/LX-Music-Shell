#!/usr/bin/env bash
# pre-push hook: 检查 AUR 元数据是否已提交
# (不主动 rebuild, 避免覆盖用户改动)

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 检查 AUR 文件是否在 unstaged 状态
if [[ -n "$(git status --porcelain -- aur/PKGBUILD aur/.SRCINFO)" ]]; then
  echo "WARN: aur/PKGBUILD 或 .SRCINFO 有未提交改动, 但不阻止推送"
  # 仅提示, 不阻止 (用户可能正在快速迭代)
fi

exit 0
