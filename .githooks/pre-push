#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ -f aur/build-aur-package.sh ]]; then
  bash aur/build-aur-package.sh --no-confirm >/dev/null 2>&1
fi

if [[ -n "$(git status --porcelain -- aur/PKGBUILD aur/.SRCINFO)" ]]; then
  echo "ERROR: AUR metadata changed after build. Please review and commit the updated files before pushing."
  git status --short -- aur/PKGBUILD aur/.SRCINFO
  exit 1
fi
