    printf '%b\n' "  ${GRAY}└─ 提示: 在 kitty 等 TUI 终端直接运行 ${BOLD}lx-music-shell${NC}${GRAY} 进入图形界面${NC}"
    printf '\n'
}

#==============================================================================
# 交互模式
#==============================================================================
interactive_mode() {
    # 简洁欢迎 (无动画闪屏)
    show_welcome
    
    while true; do
        printf '%b' "\033[32mlx>\033[0m "
        local line
        if ! IFS= read -r line; then
            # EOF (Ctrl+D) - 退出交互模式
            echo ""
            break
        fi

        if [[ -z "$line" ]]; then
            continue
        fi

        local cmd="${line%%[[:space:]]*}"
        local rest="${line#*"$cmd"}"
        rest="${rest# }"

        # 将 rest 拆分为参数数组,供需要多参数的命令使用
        local -a rest_args
        if [[ -n "$rest" ]]; then
            # shellcheck disable=SC2206  # 简单单词分割,不需要引号保留
            rest_args=($rest)
        fi
        
        # 解析并执行命令
        case "$cmd" in
            /help|/h)
                show_help
                ;;
            /search|/s)
                do_search "${rest_args[@]:-}"
                show_playlist
                ;;
            /play|/p)
                do_play "${rest_args[@]:-}"
                ;;
            /pause)
                do_pause
                ;;
            /resume|/r)
                do_resume
                ;;
            /stop)
                do_stop
                ;;
            /next|/n)
                do_next
                ;;
            /prev)
                do_prev
                ;;
            /list|/l)
                show_playlist
                ;;
            /clear)
                clear_playlist
                ;;
            /mode)
                set_play_mode "${rest_args[@]:-}"
                ;;
            /quality)
                set_quality "${rest_args[@]:-}"
                ;;
            /playlist)
                do_search_playlists "${rest_args[@]:-}"
                ;;
            /load-playlist)
                do_load_playlist_tracks "${rest_args[@]:-}"
                show_playlist
                ;;
            /recommend)
                do_recommend_songs
                show_playlist
                ;;
            /volume|/v)
                set_volume "${rest_args[@]:-}"
                ;;
            /source|/src)
                set_source "${rest_args[@]:-}"
                ;;
            /test-sources)
                test_all_sources
                ;;
            /update-sources)
                fetch_source_api
                ;;
            /import-source)
                import_source "${rest_args[@]:-}"
                ;;
            /status)
                show_status
                ;;
            /panel)
                show_panel
                ;;
            /statusbar)
                if [[ -n "$STATUS_BAR_PID" ]] && kill -0 "$STATUS_BAR_PID" 2>/dev/null; then
                    stop_status_bar
                else
                    start_status_bar
                    echo -e "\033[36m实时状态栏已启动 (再次 /statusbar 关闭, /stop 停止播放并关闭)\033[0m"
                fi
                ;;
            /network)
                echo "检查网络状态..."
                if check_connectivity; then
                    echo -e "\033[32m✓ 网络已连接\033[0m"
                    NETWORK_STATUS="connected"
                else
                    echo -e "\033[31m✗ 网络已断开\033[0m"
                    NETWORK_STATUS="disconnected"
                fi
                ;;
            /reconnect)
                echo "手动尝试重连..."
                handle_network_loss
                ;;
            /config)
                echo "当前配置:"
                echo "  播放器: $PLAYER_BACKEND"
                echo "  默认源: $DEFAULT_SOURCE"
                echo "  搜索限制: $SEARCH_LIMIT"
                echo "  播放模式: $PLAY_MODE"
                echo "  音量: $VOLUME%"
                ;;
            /quit|/q|exit)
                if [[ "${BACKGROUND_PLAY:-true}" == "true" ]]; then
                    save_player_background_state
                    stop_watchdog
                    stop_status_bar
                else
                    do_stop
                fi
                LXMS_PLAYER_HANDLED=1
                echo "再见！"
                break
                ;;
            *)
                # 非命令视为搜索
                do_search "$line"
                ;;
        esac
    done
}

#==============================================================================
# 命令行模式
#==============================================================================
command_mode() {
    local cmd="$1"
    shift
    
    case "$cmd" in
        search|-s|--search)
            do_search "$@"
            show_playlist
            ;;
        test-sources|--test-sources)
            test_all_sources
            ;;
        source|--source)
            set_source "$@"
            ;;
        quality|--quality)
            set_quality "$@"
            ;;
        playlist|--playlist)
            do_search_playlists "$@"
            ;;
        recommend|--recommend)
            do_recommend_songs
            show_playlist
            ;;
        stop|--stop)
            do_stop
            ;;
        pause|--pause)
            do_pause
            ;;
        resume|--resume)
            do_resume
            ;;
        status|--status)
            show_status
            ;;
        update-sources|--update-sources)
            fetch_source_api
            ;;
        import-source|--import-source)
            import_source "$1"
            ;;
        help|-h|--help)
            show_help
            ;;
        version|-v|--version)
            echo "LX-Music-Shell v$VERSION"
            ;;
        *)
            echo "未知命令: $cmd"
            echo "使用 --help 查看帮助"
            exit 1
            ;;
    esac
}

