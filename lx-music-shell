#==============================================================================
set_volume() {
    local vol="$1"
    
    if [[ -z "$vol" ]]; then
        echo "当前音量: $VOLUME%"
        return
    fi
    
    if ! [[ "$vol" =~ ^[0-9]+$ ]] || [[ $vol -lt 0 ]] || [[ $vol -gt 100 ]]; then
        echo -e "\033[31m错误: 音量值无效 (0-100)\033[0m"
        return 1
    fi
    
    VOLUME=$vol
    if declare -f player_set_volume >/dev/null 2>&1; then
        player_set_volume "$vol"
    fi
    echo -e "\033[32m音量: $VOLUME%\033[0m"
}

#==============================================================================
# 播放器状态
#==============================================================================
show_status() {
    local backend
    backend=$(get_player_backend) || backend="未安装"
    
    # 读取真实播放进度 (mpv IPC / 墙钟兜底)
    if declare -F player_poll >/dev/null 2>&1; then
        player_poll >/dev/null 2>&1 || true
    fi
    local position="${PLAYBACK_POSITION:-0}"
    [[ "$position" =~ ^[0-9]+$ ]] || position=0
    local position_str
    position_str=$(format_time "$position")
    local duration="${PLAYBACK_DURATION:-0}"
    [[ "$duration" =~ ^[0-9]+$ ]] || duration=0
    local duration_str
    if [[ $duration -gt 0 ]]; then duration_str=$(format_time "$duration"); else duration_str="--:--"; fi
    
    # 网络状态描述
    local net_desc
    case "$NETWORK_STATUS" in
        connected)
            net_desc="● 已连接"
            ;;
        disconnected)
            net_desc="○ 已断开"
            ;;
        reconnecting)
            net_desc="⟳ 重连中 ($RECONNECT_ATTEMPTS/$MAX_RECONNECT_ATTEMPTS)"
            ;;
        *)
            net_desc="? 未知"
            ;;
    esac
    
    echo ""
    echo "========================================"
    echo "         播放器状态"
    echo "========================================"
    echo "状态: $PLAYER_STATUS"
    echo "进度: $position_str / $duration_str"
    echo "当前歌曲: ${CURRENT_TRACK:-无}"
    echo "来源: $(source_display_name)"
    echo "播放模式: $PLAY_MODE"
    echo "音量: $VOLUME%"
    echo "播放器: $backend"
    echo "播放列表: ${#PLAYLIST[@]} 首"
    echo "当前索引: $PLAYLIST_INDEX"
    echo "----------------------------------------"
    echo "网络状态: $net_desc"
    echo "自动重连: $([ "$AUTO_RECONNECT" = "true" ] && echo "启用" || echo "禁用")"
    echo "重连尝试: $RECONNECT_ATTEMPTS/$MAX_RECONNECT_ATTEMPTS"
    echo "========================================"
    echo ""
}

