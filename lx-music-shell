EOF
}

#==============================================================================
# 源配置管理
#==============================================================================
load_sources() {
    if [[ -f "$SOURCES_FILE" ]]; then
        source "$SOURCES_FILE"
    fi
}

#==============================================================================
# 播放器后端选择
#==============================================================================
get_player_backend() {
    local backend="${PLAYER_BACKEND:-mpv}"
    
    for player in "$backend" mpv ffplay mplayer; do
        if command -v "$player" &>/dev/null; then
            echo "$player"
            return 0
        fi
    done
    
    return 1
}

#==============================================================================
# 网络状态监控 (蓝牙断线、网络中断自动重连)
#==============================================================================

# 检测网络连接
check_connectivity() {
    # 检查多个主机，确保准确判断
    local hosts=("8.8.8.8" "1.1.1.1" "223.5.5.5")
    
    for host in "${hosts[@]}"; do
        if timeout 2 ping -c 1 -W 2 "$host" &>/dev/null; then
            return 0
        fi
    done
    
    return 1
}

# 网络监控循环 (后台守护进程)
network_watchdog() {
    while true; do
        sleep "$NETWORK_CHECK_INTERVAL"
        
        # 只在播放中检查网络
        if [[ "$PLAYER_STATUS" != "playing" ]]; then
            continue
        fi
        
        local now
        now=$(date +%s)
        
        if check_connectivity; then
            if [[ "$NETWORK_STATUS" == "disconnected" ]]; then
                echo -e "\n\033[32m✓ 网络已恢复\033[0m"
                NETWORK_STATUS="connected"
                RECONNECT_ATTEMPTS=0
            fi
            NETWORK_STATUS="connected"
            LAST_CONNECTIVITY_CHECK=$now
        else
            if [[ "$NETWORK_STATUS" == "connected" ]]; then
                echo -e "\n\033[33m⚠ 网络中断，尝试重连...\033[0m"
                NETWORK_STATUS="disconnected"
                handle_network_loss
            fi
        fi
    done
}

# 处理网络丢失
handle_network_loss() {
    NETWORK_STATUS="disconnected"
    PLAYER_STATUS="buffering"
    PLAYER_BUFFERING="true"
    
    # 启动重连循环
    local attempt=0
    
    while [[ $attempt -lt $MAX_RECONNECT_ATTEMPTS ]]; do
        RECONNECT_ATTEMPTS=$((attempt + 1))
        
        echo -e "\033[36m重连尝试 $((attempt + 1))/$MAX_RECONNECT_ATTEMPTS...\033[0m"
        sleep "$RECONNECT_DELAY"
        
        if check_connectivity; then
            echo -e "\033[32m✓ 网络恢复，续播中...\033[0m"
            NETWORK_STATUS="connected"
            PLAYER_BUFFERING="false"
            PLAYER_STATUS="playing"
            
            # 重新播放当前歌曲
            if [[ $PLAYLIST_INDEX -ge 0 ]] && [[ $PLAYLIST_INDEX -lt ${#PLAYLIST[@]} ]]; then
                do_play "$PLAYLIST_INDEX" --no-message
            fi
            return 0
        fi
        
        attempt=$((attempt + 1))
    done
    
    echo -e "\033[31m✗ 重连失败，播放已停止\033[0m"
    do_stop
    return 1
}

# 启动网络监控
start_watchdog() {
    if [[ -z "$WATCHDOG_PID" ]] || ! kill -0 "$WATCHDOG_PID" 2>/dev/null; then
        network_watchdog &
        WATCHDOG_PID=$!
    fi
}

# 停止网络监控
stop_watchdog() {
    if [[ -n "$WATCHDOG_PID" ]]; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
        WATCHDOG_PID=""
    fi
}

#==============================================================================
# 播放控制
#==============================================================================
do_play() {
    local index="${1:-$PLAYLIST_INDEX}"
    local silent="${2:-}"
    
    if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
        echo -e "\033[33m播放列表为空，请先搜索歌曲\033[0m"
        return 1
    fi
    
    if ! [[ "$index" =~ ^[0-9]+$ ]] || [[ $index -lt 0 ]] || [[ $index -ge ${#PLAYLIST[@]} ]]; then
        echo -e "\033[31m错误: 无效的序号 (有效范围: 0-$(( ${#PLAYLIST[@]} - 1 )))\033[0m"
        return 1
    fi
    
    PLAYLIST_INDEX=$index
    local track="${PLAYLIST[$index]}"
    
    # 解析歌曲信息 (格式: "序号|歌名|歌手|时长|URL")
    IFS='|' read -r num name artist duration url <<< "$track"
    
    if [[ -z "$url" ]] || [[ "$url" == "null" ]]; then
        echo -e "\033[33m提示: 该歌曲无可用播放链接\033[0m"
        echo "请尝试其他源或搜索其他歌曲"
        return 1
    fi
    
    # 停止当前播放
    do_stop
    
    CURRENT_TRACK="$name - $artist"
    CURRENT_URL="$url"
    PLAYER_STATUS="playing"
    PLAYBACK_START_TIME=$(date +%s)
    
    if [[ "$silent" != "--no-message" ]]; then
        echo -e "\033[36m▶ 正在播放: $name\033[0m"
        echo -e "   歌手: $artist"
        echo -e "   来源: ${CURRENT_SOURCE_NAME:-$CURRENT_SOURCE}"
        render_status_bar
    fi
    
    local backend
    backend=$(get_player_backend) || {
        echo -e "\033[31m错误: 未找到可用的播放器\033[0m"
        echo "请安装 mpv: sudo pacman -S mpv"
        return 1
    }
    
    case "$backend" in
        mpv)
            mpv --no-video --volume="$VOLUME" --metadata-title="$name - $artist" \
                --really-quiet --save-position-on-quit "$url" &
            PLAYER_PID=$!
            ;;
        mplayer)
            mplayer -novideo -volume "$VOLUME" -quiet "$url" &
            PLAYER_PID=$!
            ;;
        ffplay)
            ffplay -nodisp -volume "$VOLUME" -autoexit "$url" &
            PLAYER_PID=$!
            ;;
    esac
    
    # 启动网络监控 (后台守护)
    start_watchdog
    
    # 后台监控播放器退出 (非阻塞)
    (
        wait "$PLAYER_PID" 2>/dev/null
        # 播放器进程退出后
        PLAYER_EXIT_CODE=$?
        if [[ "$PLAYER_STATUS" == "playing" ]] || [[ "$PLAYER_STATUS" == "buffering" ]]; then
            # 如果状态还在播放/缓冲，表示是意外中断
            if [[ "$NETWORK_STATUS" == "connected" ]]; then
                # 网络正常但播放退出 - 是正常结束
                PLAYER_STATUS="stopped"
                handle_playback_end
            else
                # 网络中断导致的退出，不处理
                :
            fi
        fi
    ) &
    WATCHER_PID=$!
    
    # 不阻塞，让用户可以继续输入命令
    return 0
}

do_pause() {
    if [[ -z "$PLAYER_PID" ]]; then
        echo -e "\033[33m没有正在播放的歌曲\033[0m"
        return
    fi
    
    kill -STOP "$PLAYER_PID" 2>/dev/null || true
    PLAYER_STATUS="paused"
    echo -e "\033[33m⏸ 已暂停\033[0m"
}

do_resume() {
    if [[ -z "$PLAYER_PID" ]]; then
        echo -e "\033[33m没有暂停的歌曲\033[0m"
        return
    fi
    
    kill -CONT "$PLAYER_PID" 2>/dev/null || true
    PLAYER_STATUS="playing"
    PLAYBACK_START_TIME=$(($(date +%s) - PLAYBACK_POSITION))
    echo -e "\033[32m▶ 继续播放\033[0m"
}

do_stop() {
    if [[ -n "$PLAYER_PID" ]]; then
        kill -9 "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
    fi
    if [[ -n "$WATCHER_PID" ]]; then
        kill "$WATCHER_PID" 2>/dev/null || true
        WATCHER_PID=""
    fi
    PLAYER_STATUS="stopped"
    echo -e "\033[31m⏹ 已停止\033[0m"
}

#==============================================================================
# 状态栏渲染
#==============================================================================

# 格式化时间为 mm:ss
format_time() {
    local seconds="${1:-0}"
    local mins=$((seconds / 60))
    local secs=$((seconds % 60))
    printf "%02d:%02d" "$mins" "$secs"
}

# 获取网络状态图标
network_icon() {
    case "$NETWORK_STATUS" in
        connected)
            echo -e "\033[32m●\033[0m"   # 绿色在线
            ;;
        disconnected)
            echo -e "\033[31m●\033[0m"   # 红色离线
            ;;
        reconnecting)
            echo -e "\033[33m●\033[0m"   # 黄色重连中
            ;;
        *)
            echo -e "\033[90m●\033[0m"   # 灰色未知
            ;;
    esac
}

# 获取播放状态图标
status_icon() {
    case "$PLAYER_STATUS" in
        playing)
            echo -e "\033[32m▶\033[0m"
            ;;
        paused)
            echo -e "\033[33m⏸\033[0m"
            ;;
        buffering)
            echo -e "\033[36m⌛\033[0m"
            ;;
        stopped)
            echo -e "\033[90m⏹\033[0m"
            ;;
        *)
            echo -e "\033[90m─\033[0m"
            ;;
    esac
}

# 绘制进度条
draw_progress_bar() {
    local position="${1:-0}"
    local duration="${2:-0}"
    local width=20
    
    if [[ "$duration" -eq 0 ]]; then
        printf "[%s]" "$(printf '─%.0s' $(seq 1 $width))"
        return
    fi
    
    local percent=$((position * 100 / duration))
    local filled=$((percent * width / 100))
    local remaining=$((width - filled))
    
    printf "[\033[32m%s\033[90m%s\033[0m]" \
        "$(printf '█%.0s' $(seq 1 $filled))" \
        "$(printf '░%.0s' $(seq 1 $remaining))"
}

# 渲染状态栏 (单行实时状态)
render_status_bar() {
    local position=0
    if [[ "$PLAYER_STATUS" == "playing" ]] && [[ $PLAYBACK_START_TIME -gt 0 ]]; then
        position=$(($(date +%s) - PLAYBACK_START_TIME))
    fi
    
    local position_str
    position_str=$(format_time "$position")
    local duration_str="--:--"
    if [[ $PLAYBACK_DURATION -gt 0 ]]; then
        duration_str=$(format_time "$PLAYBACK_DURATION")
    fi
    
    local status_str
    case "$PLAYER_STATUS" in
        playing) status_str="播放中" ;;
        paused) status_str="已暂停" ;;
        buffering) status_str="缓冲中" ;;
        stopped) status_str="已停止" ;;
        *) status_str="未知" ;;
    esac
    
    local net_str="已连接"
    case "$NETWORK_STATUS" in
        disconnected) net_str="\033[31m已断开\033[0m" ;;
        reconnecting) net_str="\033[33m重连中($RECONNECT_ATTEMPTS/$MAX_RECONNECT_ATTEMPTS)\033[0m" ;;
        *) net_str="已连接" ;;
    esac
    
    local track_info="${CURRENT_TRACK:-无}"
    if [[ ${#track_info} -gt 25 ]]; then
        track_info="${track_info:0:22}..."
    fi
    
    printf "  %s %-6s | %s | %s %s/%s | 🔊 %d%% | %s %s\n" \
        "$(status_icon)" \
        "$status_str" \
        "$track_info" \
        "$(draw_progress_bar "$position" "$PLAYBACK_DURATION")" \
        "$position_str" "$duration_str" \
        "$VOLUME" \
        "$(network_icon)" \
        "$net_str"
}

# 连续显示状态栏 (后台任务)
status_bar_loop() {
    while [[ "$PLAYER_STATUS" == "playing" ]] || [[ "$PLAYER_STATUS" == "paused" ]] || [[ "$PLAYER_STATUS" == "buffering" ]]; do
        # 清除上一行
        printf "\033[2K\r"
        render_status_bar
        sleep 1
    done
}

# 启动状态栏 (后台)
start_status_bar() {
    status_bar_loop &
    STATUS_BAR_PID=$!
}

# 停止状态栏
stop_status_bar() {
    if [[ -n "$STATUS_BAR_PID" ]]; then
        kill "$STATUS_BAR_PID" 2>/dev/null || true
        STATUS_BAR_PID=""
        printf "\n"
    fi
}

# 干净退出播放器资源
cleanup_player() {
    stop_watchdog
    stop_status_bar
    if [[ -n "$PLAYER_PID" ]]; then
        kill -9 "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
    fi
    if [[ -n "$WATCHER_PID" ]]; then
        kill "$WATCHER_PID" 2>/dev/null || true
        WATCHER_PID=""
    fi
}

do_next() {
    local next_index
    
    case "$PLAY_MODE" in
        random)
            next_index=$((RANDOM % ${#PLAYLIST[@]}))
            ;;
        *)
            next_index=$((PLAYLIST_INDEX + 1))
            ;;
    esac
    
    if [[ $next_index -ge ${#PLAYLIST[@]} ]]; then
        if [[ "$PLAY_MODE" == "loop" ]]; then
            next_index=0
        else
            echo -e "\033[33m已播放到列表末尾\033[0m"
            return 1
        fi
    fi
    
    PLAYLIST_INDEX=$next_index
    do_play "$next_index"
}

do_prev() {
    local prev_index=$((PLAYLIST_INDEX - 1))
    
    if [[ $prev_index -lt 0 ]]; then
        if [[ "$PLAY_MODE" == "loop" ]]; then
            prev_index=$((${#PLAYLIST[@]} - 1))
        else
            prev_index=0
        fi
    fi
    
    PLAYLIST_INDEX=$prev_index
    do_play "$prev_index"
}

handle_playback_end() {
    case "$PLAY_MODE" in
        single)
            do_play "$PLAYLIST_INDEX"
            ;;
        loop|random)
            do_next
            ;;
        *)
            if [[ $((PLAYLIST_INDEX + 1)) -lt ${#PLAYLIST[@]} ]]; then
                echo ""
                echo -n "是否播放下一首? (y/n): "
                read -r answer
                if [[ "$answer" =~ ^[Yy]$ ]]; then
                    do_next
                fi
            fi
            ;;
    esac
}

#==============================================================================
# 播放列表管理
#==============================================================================
show_playlist() {
    if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
        echo -e "\033[33m播放列表为空\033[0m"
        return
    fi
    
    echo ""
    echo "========================================"
    echo "         播放列表 (${#PLAYLIST[@]} 首)"
    echo "========================================"
    
    local i=0
    for track in "${PLAYLIST[@]}"; do
        IFS='|' read -r num name artist duration url <<< "$track"
        if [[ $i -eq $PLAYLIST_INDEX ]]; then
            echo -e "  \033[32m▶\033[0m $(printf '%2d' "$i") | $name | $artist | ${duration:---:--}"
        else
            echo -e "     $(printf '%2d' "$i") | $name | $artist | ${duration:---:--}"
        fi
        ((i++))
    done
    
    echo "========================================"
    echo "播放模式: $PLAY_MODE | 音量: $VOLUME%"
    echo ""
}

clear_playlist() {
    do_stop
    PLAYLIST=()
    PLAYLIST_INDEX=0
    echo -e "\033[32m✓ 播放列表已清空\033[0m"
}

add_to_playlist() {
    local track="$1"
    PLAYLIST+=("$track")
}

#==============================================================================
# 搜索功能
#==============================================================================
do_search() {
    local query="$1"
    local source="${2:-$DEFAULT_SOURCE}"
    local limit="${3:-$SEARCH_LIMIT}"
    
    if [[ -z "$query" ]]; then
        echo -e "\033[31m错误: 请输入搜索关键词\033[0m"
        return 1
    fi
    
    CURRENT_SOURCE="$source"
    
    case "$source" in
        kugou)
            CURRENT_SOURCE_NAME="酷狗音乐"
            search_kugou "$query" "$limit"
            ;;
        kuwo)
            CURRENT_SOURCE_NAME="酷我音乐"
            search_kuwo "$query" "$limit"
            ;;
        netease)
            CURRENT_SOURCE_NAME="网易云音乐"
            search_netease "$query" "$limit"
            ;;
        qq)
            CURRENT_SOURCE_NAME="QQ音乐"
            search_qq "$query" "$limit"
            ;;
        migu)
            CURRENT_SOURCE_NAME="咪咕音乐"
            search_migu "$query" "$limit"
            ;;
        ximalaya)
            CURRENT_SOURCE_NAME="喜马拉雅"
            search_ximalaya "$query" "$limit"
            ;;
        all)
            do_search_all "$query" "$limit"
            ;;
        *)
            echo -e "\033[31m错误: 不支持的源: $source\033[0m"
            return 1
            ;;
    esac
}

do_search_all() {
    local query="$1"
    local limit="${2:-5}"
    
    echo ""
    echo "========================================"
    echo "       全源搜索: $query"
    echo "========================================"
    
    local i=1
    for src in kugou kuwo netease qq migu; do
        echo ""
        echo -e "\033[1;34m>>> ${src^^} <<<\033[0m"
        
        # 清空临时播放列表
        local temp_playlist=()
        
        case "$src" in
            kugou)
                search_kugou "$query" "$limit" | tee >(while IFS= read -r line; do
                    if [[ "$line" =~ ^[0-9] ]] && [[ "$line" =~ \| ]]; then
                        echo "$line"
                    fi
                done)
                ;;
            netease)
                search_netease "$query" "$limit"
                ;;
            *)
                search_mock "$src" "$query" "$limit"
                ;;
        esac
    done
    
    echo ""
    echo "提示: 使用 /source <源名> 切换源后搜索"
}

# 模拟搜索结果
search_mock() {
    local source="$1"
    local query="$2"
    local limit="${3:-10}"
    
    local songs=(
        "稻香|周杰伦|03:42"
        "晴天|周杰伦|04:29"
        "七里香|周杰伦|04:59"
        "夜曲|周杰伦|04:26"
        "简单爱|周杰伦|04:31"
        "告白气球|周杰伦|03:35"
        "青花瓷|周杰伦|03:59"
        "双截棍|周杰伦|04:33"
    )
    
    local count=0
    for song in "${songs[@]}"; do
        ((count++))
        [[ $count -gt $limit ]] && break
        
        IFS='|' read -r name artist duration <<< "$song"
        # 添加到播放列表
        add_to_playlist "$count|$name|$artist|$duration|null"
        echo "  $count  | $name | $artist | $duration"
    done
}

