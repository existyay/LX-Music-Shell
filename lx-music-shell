#==============================================================================
# TUI 模式 (v3 重构: 统一状态机 + mpv IPC + 键盘/鼠标)
#==============================================================================

do_pause_or_resume() {
    if [[ "${PLAYER_STATUS:-stopped}" == "playing" ]]; then
        player_pause
    elif [[ "${PLAYER_STATUS:-stopped}" == "paused" ]]; then
        player_resume
    fi
}

tui_cycle_mode() {
    case "$PLAY_MODE" in
        list)   PLAY_MODE="loop" ;;
        loop)   PLAY_MODE="single" ;;
        single) PLAY_MODE="random" ;;
        *)      PLAY_MODE="list" ;;
    esac
}

tui_cycle_quality() {
    case "${DEFAULT_QUALITY:-flac}" in
        hires) DEFAULT_QUALITY="flac" ;;
        flac)  DEFAULT_QUALITY="320" ;;
        320)   DEFAULT_QUALITY="128" ;;
        *)     DEFAULT_QUALITY="hires" ;;
    esac
    save_config
}

tui_cycle_source() {
    local -a srcs
    srcs=()

    local s
    for s in netease kugou kuwo qq migu; do
        source_is_available "$s" && srcs+=("$s")
    done

    # 追加用户自定义源 (yinyuan/sources.list), 使切源功能覆盖自定义源
    local name
    for name in $(printf '%s\n' "${!SOURCE_URLS[@]}" | sort); do
        case "$name" in
            netease|kugou|kuwo|qq|migu|ximalaya) continue ;;
        esac
        source_is_available "$name" && srcs+=("$name")
    done

    [[ ${#srcs[@]} -eq 0 ]] && return 1

    local cur found=-1 i
    cur=$(normalize_source_id "${CURRENT_SOURCE:-netease}")
    for i in "${!srcs[@]}"; do
        [[ "${srcs[i]}" == "$cur" ]] && { found=$i; break; }
    done
    local next=$(( (found + 1) % ${#srcs[@]} ))
    tui_apply_source_selection "${srcs[next]}"
}

# 打开音源选择子菜单
tui_op_open_source_select() {
    # shellcheck disable=SC2034  # TUI_SELECT_TITLE 由 lib/tui.sh 读取渲染
    TUI_SELECT_TITLE="选择音源"
    TUI_SELECT_ITEMS=()
    TUI_SELECT_VALUES=()

    local src
    for src in netease kugou kuwo qq migu; do
        if source_is_available "$src"; then
            TUI_SELECT_ITEMS+=("$(source_display_name "$src")")
            TUI_SELECT_VALUES+=("$src")
        fi
    done
    # 追加自定义源 (排除内置已加)
    local name
    for name in $(printf '%s\n' "${!SOURCE_URLS[@]}" | sort); do
        case "$name" in
            netease|kugou|kuwo|qq|migu|ximalaya) continue ;;
        esac
        if source_is_available "$name"; then
            TUI_SELECT_ITEMS+=("自定义源 $name")
            TUI_SELECT_VALUES+=("$name")
        fi
    done

    UI_SCREEN="source_select"
    UI_FOCUS="list"
    UI_SELECTED=0
    UI_SCROLL_TOP=0
}

# 打开音质选择子菜单
tui_op_open_quality_select() {
    # shellcheck disable=SC2034  # TUI_SELECT_TITLE 由 lib/tui.sh 读取渲染
    TUI_SELECT_TITLE="选择音质"
    TUI_SELECT_ITEMS=("HiRes (母带)" "FLAC (无损)" "HQ (320k)" "SQ (128k)")
    TUI_SELECT_VALUES=(hires flac 320 128)
    UI_SCREEN="quality_select"
    UI_FOCUS="list"
    UI_SELECTED=0
    UI_SCROLL_TOP=0
}

# 应用音源选择
tui_apply_source_selection() {
    local src="$1"
    source_is_available "$src" || return 1
    DEFAULT_SOURCE="$src"
    CURRENT_SOURCE="$src"
    CURRENT_SOURCE_NAME="$(source_display_name "$src")"
    save_config
    UI_SCREEN="menu"
    UI_FOCUS="list"
    UI_SELECTED=0
    UI_SCROLL_TOP=0
}

# 应用音质选择
tui_apply_quality_selection() {
    local q="$1"
    case "$q" in
        hires|flac|320|128) ;;
        *) return 1 ;;
    esac
    DEFAULT_QUALITY="$q"
    save_config
    UI_SCREEN="menu"
    UI_FOCUS="list"
    UI_SELECTED=0
    UI_SCROLL_TOP=0
}

tui_volume_up() {
    local v=$((VOLUME + 5)); (( v > 100 )) && v=100
    VOLUME=$v; player_set_volume "$v" 2>/dev/null
}

tui_volume_down() {
    local v=$((VOLUME - 5)); (( v < 0 )) && v=0
    VOLUME=$v; player_set_volume "$v" 2>/dev/null
}

tui_confirm_search() {
    if [[ -n "${UI_QUERY:-}" ]]; then
        if [[ "${UI_SEARCH_MODE:-song}" == "playlist" ]]; then
            do_search_playlists "$UI_QUERY" >/dev/null 2>&1
            UI_SCREEN="playlist_select"
        else
            do_search "$UI_QUERY" >/dev/null 2>&1
            UI_SCREEN="search"
        fi
    fi
    UI_FOCUS="list"
    UI_SELECTED=0
    UI_SCROLL_TOP=0
}

# 菜单/列表确认 (Enter)
tui_op_select() {
    if [[ "${UI_SCREEN:-menu}" == "search" ]]; then
        if [[ ${#PLAYLIST[@]} -gt 0 ]]; then
            do_play "$UI_SELECTED" --no-message
        fi
        return
    fi
    if [[ "${UI_SCREEN:-menu}" == "playlist_select" ]]; then
        do_load_playlist_tracks "${TUI_SELECT_VALUES[$UI_SELECTED]:-}" >/dev/null 2>&1
        UI_SCREEN="search"; UI_FOCUS="list"; UI_SELECTED=0; UI_SCROLL_TOP=0
        return
    fi
    if [[ "${UI_SCREEN:-menu}" == "source_select" ]]; then
        tui_apply_source_selection "${TUI_SELECT_VALUES[$UI_SELECTED]:-}"
        return
    fi
    if [[ "${UI_SCREEN:-menu}" == "quality_select" ]]; then
        tui_apply_quality_selection "${TUI_SELECT_VALUES[$UI_SELECTED]:-}"
        return
    fi

    local action
    action=$(tui_menu_selected_action)
    case "$action" in
        search)   tui_op_start_search ;;
        playlist_search) tui_op_start_playlist_search ;;
        recommend)
            do_recommend_songs >/dev/null 2>&1
            UI_SCREEN="search"; UI_FOCUS="list"; UI_SELECTED=0; UI_SCROLL_TOP=0
            ;;
        playlist) UI_SCREEN="search"; UI_FOCUS="list"; UI_QUERY=""; UI_SELECTED=0; UI_SCROLL_TOP=0 ;;
        quality)  tui_op_open_quality_select ;;
        mode)     tui_cycle_mode; save_config ;;
        help)     UI_SCREEN="help" ;;
        quit)     UI_QUIT=1 ;;
    esac
}

# 鼠标点击分发
tui_handle_click() {
    local x="$1" y="$2" action
    if ! action=$(tui_mouse_action "$x" "$y" 2>/dev/null); then return; fi
    case "$action" in
        search)
            UI_FOCUS="search"
            ;;
        list:*)
            local idx="${action#list:}"
            if [[ "$idx" =~ ^[0-9]+$ ]] && (( idx < ${#PLAYLIST[@]} )); then
                UI_SELECTED=$idx
                do_play "$idx" --no-message
            fi
            ;;
        menu:*)
            local mi="${action#menu:}"
            if [[ "$mi" =~ ^[0-9]+$ ]]; then
                UI_SELECTED=$mi
                tui_op_select
            fi
            ;;
        select:*)
            local si="${action#select:}"
            if [[ "$si" =~ ^[0-9]+$ ]] && (( si < ${#TUI_SELECT_ITEMS[@]} )); then
                UI_SELECTED=$si
                tui_op_select
            fi
            ;;
        toggle)
            do_pause_or_resume
            ;;
        next)
            do_next
            ;;
        seek:*)
            local pct="${action#seek:}"
            if [[ "${PLAYBACK_DURATION:-0}" =~ ^[0-9]+$ ]] && (( PLAYBACK_DURATION > 0 )); then
                local sec=$(( pct * PLAYBACK_DURATION / 100 ))
                player_seek "$sec"
            fi
            ;;
    esac
}

interactive_mode_tui() {
    if [[ "${LXMS_UI_CAPABILITY_AVAILABLE:-0}" != "1" ]]; then
        interactive_mode
        return
    fi

    capability_apply_config "$CONFIG_FILE"
    detect_capability
    if [[ "${LXMS_FORCE_TUI:-0}" != "1" ]]; then
        interactive_mode
        return
    fi

    LXMS_TUI_ACTIVE=1
    UI_QUIT=0
    UI_SCREEN="menu"
    UI_SELECTED=0
    # shellcheck disable=SC2034  # TUI 滚动状态供 tui.sh 读取
    UI_SCROLL_TOP=0
    UI_FOCUS="list"
    UI_SEARCH_MODE="song"

    if supports_mouse; then input_enable_mouse; fi
    tui_splash_loading
    tui_enter
    # 终端 resize 时清屏一次 (tui.sh 内部处理), 避免旧尺寸残留
    trap 'tui_on_resize' WINCH

    local running=1 ev_type ev_data ev_x ev_y
    local snap_status="" snap_pos="" snap_dur="" snap_track="" snap_mode="" snap_vol="" snap_net="" snap_src="" snap_qual=""
    local poll_counter=0
    TUI_DIRTY=1
    while [[ $running -eq 1 ]] && [[ "${UI_QUIT:-0}" != "1" ]]; do
        # 同步播放器真实状态 + 曲目结束自动下一首
        # 每 3 个循环 (~0.6s) 轮询一次 mpv, 降低播放时的 python 子进程开销
        if (( (poll_counter % 3) == 0 )); then
            player_poll >/dev/null 2>&1 || true
        fi
        poll_counter=$((poll_counter + 1))
        if [[ "${PLAYER_EOF:-0}" == "1" ]]; then
            PLAYER_EOF=0
            handle_playback_end
            TUI_DIRTY=1
        fi

        # 状态/进度变化才触发重绘, 避免无变化时每帧全屏重绘造成闪屏
        if [[ "${PLAYER_STATUS}" != "$snap_status" || "${PLAYBACK_POSITION:-0}" != "$snap_pos" || "${PLAYBACK_DURATION:-0}" != "$snap_dur" || "${CURRENT_TRACK}" != "$snap_track" || "${PLAY_MODE}" != "$snap_mode" || "${VOLUME}" != "$snap_vol" || "${NETWORK_STATUS}" != "$snap_net" || "${CURRENT_SOURCE_NAME}" != "$snap_src" || "${DEFAULT_QUALITY}" != "$snap_qual" ]]; then
            TUI_DIRTY=1
        fi

        if [[ "${TUI_DIRTY:-1}" == "1" ]]; then
            tui_render
            snap_status="${PLAYER_STATUS}"
            snap_pos="${PLAYBACK_POSITION:-0}"
            snap_dur="${PLAYBACK_DURATION:-0}"
            snap_track="${CURRENT_TRACK}"
            snap_mode="${PLAY_MODE}"
            snap_vol="${VOLUME}"
            snap_net="${NETWORK_STATUS}"
            snap_src="${CURRENT_SOURCE_NAME}"
            snap_qual="${DEFAULT_QUALITY}"
            TUI_DIRTY=0
        fi

        if ! input_read_event 0.2; then
            if [[ ! -t 0 ]]; then break; fi
            continue
        fi
        TUI_DIRTY=1
        ev_type="${EVENT_TYPE:-0}"
        ev_data="${EVENT_DATA:-}"
        ev_x="${EVENT_DATA_X:-0}"
        ev_y="${EVENT_DATA_Y:-0}"

        # 搜索框聚焦: 字符输入优先
        if [[ "${UI_FOCUS:-list}" == "search" ]]; then
            case "$ev_type" in
                "$EVENT_KEY_ESC")        tui_op_search_cancel ;;
                "$EVENT_KEY_ENTER")      tui_confirm_search ;;
                "$EVENT_KEY_BACKSPACE")  tui_op_search_backspace ;;
                "$EVENT_KEY_SPACE")      tui_op_search_append " " ;;
                "$EVENT_KEY_CHAR")       tui_op_search_append "$ev_data" ;;
                "$EVENT_MOUSE_CLICK"|"$EVENT_MOUSE_DOUBLE") tui_handle_click "$ev_x" "$ev_y" ;;
                "$EVENT_MOUSE_SCROLL_UP")   tui_op_move_up ;;
                "$EVENT_MOUSE_SCROLL_DOWN") tui_op_move_down ;;
            esac
            continue
        fi

        case "$ev_type" in
            "$EVENT_KEY_ESC")
                if [[ "${UI_SCREEN:-menu}" == "menu" ]]; then running=0; else tui_op_search_cancel; fi
                ;;
            "$EVENT_KEY_UP")          tui_op_move_up ;;
            "$EVENT_KEY_DOWN")        tui_op_move_down ;;
            "$EVENT_KEY_ENTER")       tui_op_select ;;
            "$EVENT_KEY_SPACE")       do_pause_or_resume ;;
            "$EVENT_KEY_PAGE_DOWN")   tui_op_next_page ;;
            "$EVENT_KEY_PAGE_UP")     tui_op_prev_page ;;
            "$EVENT_KEY_HOME")        tui_op_move_top ;;
            "$EVENT_KEY_END")         tui_op_move_bottom ;;
            "$EVENT_MOUSE_CLICK"|"$EVENT_MOUSE_DOUBLE") tui_handle_click "$ev_x" "$ev_y" ;;
            "$EVENT_MOUSE_SCROLL_UP")   tui_op_move_up ;;
            "$EVENT_MOUSE_SCROLL_DOWN") tui_op_move_down ;;
            "$EVENT_KEY_CHAR")
                case "$ev_data" in
                    q|Q) running=0 ;;
                    /)   tui_op_start_search ;;
                    j)   tui_op_move_down ;;
                    k)   tui_op_move_up ;;
                    g)   tui_op_move_top ;;
                    G)   tui_op_move_bottom ;;
                    n)   do_next ;;
                    p)   do_prev ;;
                    m)   tui_cycle_mode ;;
                    c)   tui_cycle_quality ;;
                    +|=) tui_volume_up ;;
                    -)   tui_volume_down ;;
                esac
                ;;
        esac
    done

    if supports_mouse; then input_disable_mouse; fi
    trap - WINCH 2>/dev/null || true
    if [[ "${BACKGROUND_PLAY:-true}" == "true" ]]; then
        save_player_background_state
        stop_watchdog
        stop_status_bar
        printf '\n'
    else
        do_stop
    fi
    LXMS_PLAYER_HANDLED=1
    tui_cleanup
    LXMS_TUI_ACTIVE=0
    printf '
'
}
# 命令行入口 (v2.0)
#==============================================================================
main() {
    # 先加载配置和模块 (含 yinyuan/源框架), 再加载源列表,
    # 这样 load_sources 才能读回加密存储的自定义音源。
    load_config
    load_modules
    load_sources

    # 初始化当前源显示名 (避免 TUI/状态栏显示内部英文 id, 如 netease)
    CURRENT_SOURCE="${DEFAULT_SOURCE}"
    CURRENT_SOURCE_NAME="$(source_display_name)"

    # 检测并接管上次退到后台的播放器
    player_adopt_background

    # 应用源框架配置 (音质等)
    if [[ "${LXMS_SOURCES_AVAILABLE:-0}" == "1" ]]; then
        source_base_load_config "$CONFIG_FILE"
        # 加载 LX-Music 聚合 API 配置 (URL, KEY, TIMEOUT)
        if declare -F lx_api_load_config >/dev/null 2>&1; then
            lx_api_load_config "$CONFIG_FILE"
        fi
    fi

    # 解析命令行参数
    # use_tui=auto -> -1 (根据能力决定)
    # use_tui=force-on -> 1 (--tui 很明确)
    # use_tui=force-off -> 0 (--cli 很明确)
    local use_tui=-1
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tui)
                use_tui=1
                shift
                ;;
            --cli)
                use_tui=0
                shift
                ;;
            --tui-status)
                # 调试: 显示终端能力检测结果
                load_modules
                capability_apply_config "$CONFIG_FILE"
                detect_capability
                capability_print_status
                exit 0
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    if [[ $use_tui -eq 1 ]]; then
        # 显式 --tui
        interactive_mode_tui
    elif [[ $use_tui -eq 0 ]]; then
        # 显式 --cli
        if [[ ${#args[@]} -eq 0 ]]; then
            interactive_mode
        else
            command_mode "${args[@]}"
        fi
    elif [[ ${#args[@]} -eq 0 ]]; then
        # 无参数 - 自动判断模式
        if [[ "${LXMS_UI_TUI_AVAILABLE:-0}" == "1" ]]; then
            capability_apply_config "$CONFIG_FILE"
            detect_capability
            if [[ "${LXMS_FORCE_TUI:-0}" == "1" ]]; then
                interactive_mode_tui
            else
                interactive_mode
            fi
        else
            interactive_mode
        fi
    else
        command_mode "${args[@]}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
