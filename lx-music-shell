# 规范化源 id (别名 -> 内部 id)
normalize_source_id() {
    case "$1" in
        wy|netease) printf 'netease' ;;
        kg|kugou)   printf 'kugou' ;;
        kw|kuwo)    printf 'kuwo' ;;
        tx|qq)      printf 'qq' ;;
        mg|migu)    printf 'migu' ;;
        *)          printf '%s' "${1:-netease}" ;;
    esac
}

# 源显示名 (UI 中不显示英文内部 id, 网易云显示为中文)
source_display_name() {
    case "$(normalize_source_id "${1:-${CURRENT_SOURCE:-netease}}")" in
        netease)   printf '网易云音乐' ;;
        kugou)     printf '酷狗音乐' ;;
        kuwo)      printf '酷我音乐' ;;
        qq)        printf 'QQ音乐' ;;
        migu)      printf '咪咕音乐' ;;
        ximalaya)  printf '喜马拉雅' ;;
        all)       printf '聚合搜索' ;;
        *)         if [[ -n "${SOURCE_URLS[${1:-${CURRENT_SOURCE:-}}]:-}" ]]; then printf '自定义源 %s' "${1:-${CURRENT_SOURCE}}"; else printf '%s' "${1:-${CURRENT_SOURCE:-netease}}"; fi ;;
    esac
}

# 源是否真实可用 (有注册搜索函数或已配置自定义搜索 URL)
source_is_available() {
    local src
    src=$(normalize_source_id "$1")
    [[ -z "$src" ]] && return 1
    declare -F "${src}_search" >/dev/null 2>&1 && return 0
    [[ -n "${SOURCE_URLS[$src]:-}" ]] && return 0
    return 1
}

# 后台拉取歌词 (netease 直连优先, 失败回退 LX API)
fetch_lyrics_async() {
    local song_id="$1" src="${2:-netease}"
    local lrc=""
    if [[ "$src" == "netease" ]] && declare -F netease_get_lyrics >/dev/null 2>&1; then
        lrc=$(netease_get_lyrics "$song_id" 2>/dev/null)
    fi
    [[ -z "$lrc" ]] && declare -F lx_api_get_lyric_impl >/dev/null 2>&1 && \
        lrc=$(lx_api_get_lyric_impl "$src" "$song_id" 2>/dev/null)
    # shellcheck disable=SC2034  # 歌词供 tui.sh 渲染
    [[ -n "$lrc" ]] && LXMS_LRC_RAW="$lrc"
}

# 后台下载封面到本地缓存 (供 kitty 图形协议渲染)
fetch_cover_async() {
    local cover="$1"
    if [[ -z "$cover" ]] || [[ "$cover" == "null" ]] || [[ "$cover" != http* ]]; then
        TUI_COVER_FILE=""
        return 0
    fi
    local cover_dir="${CACHE_DIR}/covers"
    mkdir -p "$cover_dir"
    local hash f
    hash=$(printf '%s' "$cover" | md5sum 2>/dev/null | cut -d' ' -f1)
    [[ -z "$hash" ]] && hash=$(printf '%s' "$cover" | cksum 2>/dev/null | cut -d' ' -f1)
    f="$cover_dir/${hash}.jpg"
    if [[ ! -s "$f" ]]; then
        curl -s --connect-timeout 6 --max-time 15 -o "$f" "$cover" 2>/dev/null || rm -f "$f"
    fi
    # shellcheck disable=SC2034  # 封面路径供 tui.sh 渲染
    if [[ -s "$f" ]]; then TUI_COVER_FILE="$f"; else TUI_COVER_FILE=""; fi
}

do_play() {
    local index="${1:-$PLAYLIST_INDEX}"
    local silent="${2:-}"

    if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
        [[ "$silent" != "--no-message" ]] && echo -e "\033[33m播放列表为空，请先搜索歌曲\033[0m"
        return 1
    fi
    if ! [[ "$index" =~ ^[0-9]+$ ]] || [[ $index -lt 0 ]] || [[ $index -ge ${#PLAYLIST[@]} ]]; then
        [[ "$silent" != "--no-message" ]] && echo -e "\033[31m错误: 无效的序号\033[0m"
        return 1
    fi

    PLAYLIST_INDEX=$index
    local track="${PLAYLIST[index]}"

    # 统一 10 列: name|artist|album|duration|song_id|quality|cover|quals|url|src
    local name artist album duration song_id quality cover quals url track_src
    IFS='|' read -r name artist album duration song_id quality cover quals url track_src <<< "$track"
    [[ -z "$name" ]] && name="未知"
    [[ -z "$artist" ]] && artist="未知歌手"

    local src
    if [[ -n "$track_src" ]]; then
        src=$(normalize_source_id "$track_src")
    else
        src=$(normalize_source_id "${CURRENT_SOURCE:-${DEFAULT_SOURCE:-netease}}")
    fi

    # 解析真实播放 URL (音质回退链)
    if [[ -z "$url" ]] || [[ "$url" == "null" ]]; then
        # 1) song_id 本身若是可直接播放的 URL (某些自定义源直接返回), 直接使用
        if [[ "$song_id" == http* ]]; then
            url="$song_id"
            quality="--"
        # 2) 源框架解析 (内置源: netease 直连 / kugou..migu 走 LX API)
        elif declare -F source_base_get_play_url >/dev/null 2>&1; then
            local qr
            qr=$(source_base_get_play_url "$src" "$song_id" "${DEFAULT_QUALITY:-flac}" 2>/dev/null)
            quality="${qr%%:*}"
            url="${qr#*:}"
        fi
        # 回写解析结果 (保留来源列)
        PLAYLIST[index]="$name|$artist|$album|$duration|$song_id|$quality|$cover|$quals|$url|$src"
        track="${PLAYLIST[index]}"
    fi

    # 原始源解析失败时, 自动测试其他可用源并按同名歌曲解析 (无感回退)
    if [[ -z "$url" ]] || [[ "$url" != http* ]]; then
        local auto_res
        auto_res="$(_auto_resolve_url "$name" "$artist" "$src")"
        if [[ -n "$auto_res" ]]; then
            IFS='|' read -r src quality url <<< "$auto_res"
            if [[ "$url" == http* ]]; then
                PLAYLIST[index]="$name|$artist|$album|$duration|$song_id|$quality|$cover|$quals|$url|$src"
                track="${PLAYLIST[index]}"
            fi
        fi
    fi

    if [[ -z "$url" ]] || [[ "$url" != http* ]]; then
        [[ "$silent" != "--no-message" ]] && {
            echo -e "\033[33m提示: 该歌曲无可用播放链接\033[0m"
            echo "已自动测试所有可用源; 仍无法解析时可检查网络或 LX_API_URL 配置。"
        }
        PLAYER_STATUS="stopped"
        return 1
    fi

    CURRENT_TRACK="$name - $artist"

    # 用 mpv IPC 后端启动播放
    if ! player_start "$url" "$CURRENT_TRACK"; then
        [[ "$silent" != "--no-message" ]] && echo -e "\033[31m错误: 无法启动播放器 (请安装 mpv)\033[0m"
        PLAYER_STATUS="stopped"
        return 1
    fi
    player_set_volume "$VOLUME"

    if [[ "$silent" != "--no-message" ]]; then
        echo -e "\033[36m▶ 正在播放: $name\033[0m"
        echo -e "   歌手: $artist"
        echo -e "   来源: $(source_display_name "$src")"
    fi

    # 后台拉取歌词 + 封面
    fetch_lyrics_async "$song_id" "$src" &
    fetch_cover_async "$cover" &

    # 启动网络监控 (后台守护)
    start_watchdog
    return 0
}

do_pause() {
    if ! player_is_running; then
        echo -e "\033[33m没有正在播放的歌曲\033[0m"
        return
    fi
    player_pause
    echo -e "\033[33m⏸ 已暂停\033[0m"
}

do_resume() {
    if ! player_is_running; then
        echo -e "\033[33m没有暂停的歌曲\033[0m"
        return
    fi
    player_resume
    echo -e "\033[32m▶ 继续播放\033[0m"
}

do_stop() {
    player_stop
    stop_watchdog
    stop_status_bar
    rm -f "${CACHE_DIR}/player-state" 2>/dev/null || true
    [[ "${LXMS_TUI_ACTIVE:-0}" != "1" ]] && echo -e "\033[31m⏹ 已停止\033[0m"
}

#==============================================================================
# 状态栏渲染
