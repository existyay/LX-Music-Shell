#==============================================================================
# 源连通性测试
#==============================================================================
test_source_connectivity() {
    local source_name="$1"
    local source_url="$2"
    local timeout="${3:-5}"
    
    if [[ -z "$source_url" ]]; then
        echo -e "\033[33m⚠  $source_name: 未配置\033[0m"
        return 1
    fi
    
    local domain
    domain=$(echo "$source_url" | sed -E 's|https?://([^/]+).*|\1|')
    
    local http_code
    http_code=$(timeout "$timeout" curl -s --connect-timeout "$timeout" \
        -o /dev/null -w "%{http_code}" --max-time "$timeout" "https://$domain" 2>/dev/null || echo "000")
    
    if [[ "$http_code" =~ ^[23] ]]; then
        echo -e "\033[32m✓ $source_name: 正常 (HTTP $http_code)\033[0m"
        return 0
    fi
    
    http_code=$(timeout "$timeout" curl -s --connect-timeout "$timeout" \
        -o /dev/null -w "%{http_code}" --max-time "$timeout" "http://$domain" 2>/dev/null || echo "000")
    
    if [[ "$http_code" =~ ^[23] ]]; then
        echo -e "\033[32m✓ $source_name: 正常 (HTTP $http_code)\033[0m"
        return 0
    fi
    
    echo -e "\033[31m✗ $source_name: 失败 (HTTP $http_code)\033[0m"
    return 1
}

test_all_sources() {
    echo "========================================"
    echo "       音乐源连通性测试"
    echo "========================================"
    echo ""
    
    declare -A sources=(
        ["酷狗音乐"]="https://www.kugou.com"
        ["酷我音乐"]="https://www.kuwo.cn"
        ["QQ音乐"]="https://y.qq.com"
        ["网易云音乐"]="https://music.163.com"
        ["咪咕音乐"]="https://music.migu.cn"
        ["喜马拉雅"]="https://www.ximalaya.com"
    )
    
    local success=0
    local fail=0
    
    for name in "${!sources[@]}"; do
        if test_source_connectivity "$name" "${sources[$name]}"; then
            success=$((success + 1))
        else
            fail=$((fail + 1))
        fi
    done
    
    echo ""
    echo "========================================"
    echo "测试完成: 成功 $success, 失败 $fail"
    echo "========================================"
}

