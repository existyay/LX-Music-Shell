# 颜色定义 (用于输出)
#==============================================================================
NC='\033[0m'             # No Color (重置)
BOLD='\033[1m'            # 加粗
MAGENTA='\033[0;35m'      # 洋红
WHITE='\033[1;37m'        # 白色
GRAY='\033[0;90m'         # 灰色

#==============================================================================
# 配置目录
#==============================================================================
# 配置目录
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lx-music-shell"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/lx-music-shell"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lx-music-shell"
LIB_DIR="${DATA_DIR}/lib"

# 创建必要目录
mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR"

# 配置文件
CONFIG_FILE="$CONFIG_DIR/config"
SOURCES_FILE="$CONFIG_DIR/sources.list"

declare -A SOURCE_URLS=()

# 默认配置
DEFAULT_PLAYER="mpv"
DEFAULT_SOURCE="netease"
SEARCH_LIMIT=20

# 播放器状态
PLAYER_PID=""
PLAYER_STATUS="stopped"
CURRENT_TRACK=""
CURRENT_SOURCE="$DEFAULT_SOURCE"
CURRENT_SOURCE_NAME=""
PLAYLIST=()
PLAYLIST_INDEX=0

# 播放模式
PLAY_MODE="${PLAY_MODE:-list}"
VOLUME="${VOLUME:-80}"

# 网络监控状态
NETWORK_STATUS="connected"      # connected | disconnected | reconnecting
NETWORK_CHECK_INTERVAL=3        # 秒
RECONNECT_ATTEMPTS=0
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY=2               # 秒
WATCHDOG_PID=""

# 缓冲/播放进度
# shellcheck disable=SC2034  # 播放状态供 player.sh / tui.sh 读取
PLAYBACK_POSITION=0             # 秒
PLAYBACK_DURATION=0             # 秒

# 加载模块
load_modules() {
    # 加载可选的 UI 辅助库 (如果存在)
    local lib_path

    # 尝试多个可能的库目录
    for path in \
        "$(dirname "$0")/lib" \
        "/usr/local/share/lx-music-shell/lib" \
        "/usr/share/lx-music-shell/lib" \
        "$LIB_DIR"; do
        if [[ -d "$path" ]]; then
            lib_path="$path"
            break
        fi
    done

    if [[ -n "$lib_path" ]]; then
        # shellcheck disable=SC1091  # UI 辅助库可能不存在
        [[ -f "$lib_path/ui.sh" ]] && source "$lib_path/ui.sh"
        # 保留 player.sh / search.sh / download.sh 为未来插件预留位置
        # shellcheck disable=SC1091
        [[ -f "$lib_path/player.sh" ]] && source "$lib_path/player.sh"
        # shellcheck disable=SC1091
        [[ -f "$lib_path/search.sh" ]] && source "$lib_path/search.sh"
        # shellcheck disable=SC1091
        [[ -f "$lib_path/download.sh" ]] && source "$lib_path/download.sh"

        # v2.0 新增 TUI 模块
        if [[ -f "$lib_path/capability.sh" ]]; then
            # shellcheck disable=SC1091
            source "$lib_path/capability.sh"
            LXMS_UI_CAPABILITY_AVAILABLE=1
        fi
        if [[ -f "$lib_path/input.sh" ]]; then
            # shellcheck disable=SC1091
            source "$lib_path/input.sh"
        fi
        if [[ -f "$lib_path/tui.sh" ]]; then
            # shellcheck disable=SC1091
            source "$lib_path/tui.sh"
            LXMS_UI_TUI_AVAILABLE=1
        fi
        # v3.1 音源管理 (yinyuan, 混淆加密存储)
        if [[ -f "$lib_path/yinyuan.sh" ]]; then
            # shellcheck disable=SC1091
            source "$lib_path/yinyuan.sh"
        fi
    fi

    # 加载音乐源 (v2.0)
    local source_dir
    source_dir="$(dirname "$0")/sources"
    if [[ ! -d "$source_dir" ]]; then
        source_dir="/usr/share/lx-music-shell/sources"
    fi
    if [[ -d "$source_dir" ]]; then
        # shellcheck disable=SC1091
        [[ -f "$source_dir/_base.sh" ]] && source "$source_dir/_base.sh"
        for src_file in "$source_dir"/*.sh; do
            [[ -f "$src_file" ]] || continue
            [[ "$(basename "$src_file")" == "_base.sh" ]] && continue
            # shellcheck disable=SC1090,SC1091  # 动态加载已注册的源
            source "$src_file"
        done
        LXMS_SOURCES_AVAILABLE=1
    fi
}

