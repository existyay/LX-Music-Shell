# 格式化时间为 mm:ss
format_time() {
    local seconds="${1:-0}"
    local mins=$((seconds / 60))
    local secs=$((seconds % 60))
    printf "%02d:%02d" "$mins" "$secs"
}

# 获取网络状态图标
network_icon() {
    case "$NETWORK_STATUS" in
        connected)
            echo -e "\033[32m●\033[0m"   # 绿色在线
            ;;
        disconnected)
            echo -e "\033[31m●\033[0m"   # 红色离线
            ;;
        reconnecting)
            echo -e "\033[33m●\033[0m"   # 黄色重连中
            ;;
        *)
            echo -e "\033[90m●\033[0m"   # 灰色未知
            ;;
    esac
}

# 获取播放状态图标
status_icon() {
    case "$PLAYER_STATUS" in
        playing)
            echo -e "\033[32m▶\033[0m"
            ;;
        paused)
            echo -e "\033[33m⏸\033[0m"
            ;;
        buffering)
            echo -e "\033[36m⌛\033[0m"
            ;;
        stopped)
            echo -e "\033[90m⏹\033[0m"
            ;;
        *)
            echo -e "\033[90m─\033[0m"
            ;;
    esac
}

# 绘制进度条
draw_progress_bar() {
    local position="${1:-0}"
    local duration="${2:-0}"
    local width=20
    
    if [[ "$duration" -eq 0 ]]; then
        printf "[%s]" "$(printf '─%.0s' $(seq 1 $width))"
        return
    fi
    
    local percent=$((position * 100 / duration))
    local filled=$((percent * width / 100))
    local remaining=$((width - filled))
    
    printf "[\033[32m%s\033[90m%s\033[0m]" \
        "$(printf '█%.0s' $(seq 1 $filled))" \
        "$(printf '░%.0s' $(seq 1 $remaining))"
}

# 渲染状态栏 (单行实时状态)
render_status_bar() {
    # 有 mpv IPC 后端时读取真实播放进度 (time-pos/duration)
    if declare -F player_poll >/dev/null 2>&1; then
        player_poll >/dev/null 2>&1 || true
    fi

    local position="${PLAYBACK_POSITION:-0}"
    [[ "$position" =~ ^[0-9]+$ ]] || position=0
    local position_str
    position_str=$(format_time "$position")
    local duration="${PLAYBACK_DURATION:-0}"
    [[ "$duration" =~ ^[0-9]+$ ]] || duration=0
    local duration_str="--:--"
    if [[ $duration -gt 0 ]]; then
        duration_str=$(format_time "$duration")
    fi
    
    local status_str
    case "$PLAYER_STATUS" in
        playing) status_str="播放中" ;;
        paused) status_str="已暂停" ;;
        buffering) status_str="缓冲中" ;;
        stopped) status_str="已停止" ;;
        *) status_str="未知" ;;
    esac
    
    local net_str="已连接"
    case "$NETWORK_STATUS" in
        disconnected) net_str="\033[31m已断开\033[0m" ;;
        reconnecting) net_str="\033[33m重连中($RECONNECT_ATTEMPTS/$MAX_RECONNECT_ATTEMPTS)\033[0m" ;;
        *) net_str="已连接" ;;
    esac
    
    local track_info="${CURRENT_TRACK:-无}"
    if [[ ${#track_info} -gt 25 ]]; then
        track_info="${track_info:0:22}..."
    fi
    
    printf "  %s %-6s | %s | %s %s/%s | 🔊 %d%% | %s %s\n" \
        "$(status_icon)" \
        "$status_str" \
        "$track_info" \
        "$(draw_progress_bar "$position" "$PLAYBACK_DURATION")" \
        "$position_str" "$duration_str" \
        "$VOLUME" \
        "$(network_icon)" \
        "$net_str"
}

# 连续显示状态栏 (后台任务)
status_bar_loop() {
    while [[ "$PLAYER_STATUS" == "playing" ]] || [[ "$PLAYER_STATUS" == "paused" ]] || [[ "$PLAYER_STATUS" == "buffering" ]]; do
        # 清除上一行
        printf "\033[2K\r"
        render_status_bar
        sleep 1
    done
}

# 启动状态栏 (后台)
start_status_bar() {
    status_bar_loop &
    STATUS_BAR_PID=$!
}

# 停止状态栏
stop_status_bar() {
    if [[ -n "$STATUS_BAR_PID" ]]; then
        kill "$STATUS_BAR_PID" 2>/dev/null || true
        STATUS_BAR_PID=""
        printf "\n"
    fi
}

# 干净退出播放器资源
cleanup_player() {
    stop_watchdog
    stop_status_bar
    if declare -f player_cleanup >/dev/null 2>&1; then
        player_cleanup
    elif [[ -n "$PLAYER_PID" ]]; then
        kill -9 "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
    fi
    rm -f "${CACHE_DIR}/player-state" 2>/dev/null || true
}

# 保存后台播放状态, 供下次启动时恢复控制
save_player_background_state() {
    if declare -f player_is_running >/dev/null 2>&1 && player_is_running; then
        mkdir -p "$CACHE_DIR"
        cat > "${CACHE_DIR}/player-state" <<EOF
PLAYER_PID="${PLAYER_PID}"
PLAYER_SOCKET="${PLAYER_SOCKET}"
PLAYER_STATUS="${PLAYER_STATUS:-playing}"
PLAYER_VOLUME="${PLAYER_VOLUME:-80}"
CURRENT_TRACK="${CURRENT_TRACK}"
PLAY_MODE="${PLAY_MODE:-list}"
VOLUME="${VOLUME:-80}"
EOF
        return 0
    fi
    rm -f "${CACHE_DIR}/player-state" 2>/dev/null || true
    return 1
}

# 启动时检测并接管上次退到后台的播放器
player_adopt_background() {
    local state_file="${CACHE_DIR}/player-state"
    [[ -f "$state_file" ]] || return 0
    # shellcheck disable=SC1090
    source "$state_file" 2>/dev/null || { rm -f "$state_file"; return 0; }

    if [[ -n "${PLAYER_SOCKET:-}" ]] && [[ -S "${PLAYER_SOCKET:-}" ]]; then
        PLAYER_PID="${PLAYER_PID:-}"
        PLAYER_STATUS="${PLAYER_STATUS:-playing}"
        PLAYER_EOF=0
        PLAYER_VOLUME="${PLAYER_VOLUME:-${VOLUME:-80}}"
        CURRENT_TRACK="${CURRENT_TRACK:-}"
        # 确认 socket 可用; 若播放器已死则清理状态
        if declare -F player_poll >/dev/null 2>&1; then
            player_poll >/dev/null 2>&1 || {
                rm -f "$state_file"
                PLAYER_PID=""
                PLAYER_SOCKET=""
                PLAYER_STATUS="stopped"
            }
        fi
    else
        rm -f "$state_file"
        PLAYER_PID=""
        PLAYER_SOCKET=""
        PLAYER_STATUS="stopped"
    fi
}

do_next() {
    local n=${#PLAYLIST[@]}
    [[ $n -eq 0 ]] && { echo -e "\033[33m播放列表为空\033[0m"; return 1; }
    local next_index
    case "$PLAY_MODE" in
        random)
            next_index=$((RANDOM % n))
            ;;
        *)
            next_index=$((PLAYLIST_INDEX + 1))
            ;;
    esac
    
    if [[ $next_index -ge $n ]]; then
        if [[ "$PLAY_MODE" == "loop" ]]; then
            next_index=0
        else
            return 1
        fi
    fi
    
    do_play "$next_index" --no-message
}

do_prev() {
    local n=${#PLAYLIST[@]}
    [[ $n -eq 0 ]] && { echo -e "\033[33m播放列表为空\033[0m"; return 1; }
    local prev_index=$((PLAYLIST_INDEX - 1))
    
    if [[ $prev_index -lt 0 ]]; then
        if [[ "$PLAY_MODE" == "loop" ]]; then
            prev_index=$((n - 1))
        else
            prev_index=0
        fi
    fi
    
    do_play "$prev_index" --no-message
}

handle_playback_end() {
    local n=${#PLAYLIST[@]}
    case "$PLAY_MODE" in
        single)
            do_play "$PLAYLIST_INDEX" --no-message
            ;;
        loop|random)
            do_next
            ;;
        *)
            if [[ $((PLAYLIST_INDEX + 1)) -lt $n ]]; then
                do_next
            fi
            ;;
    esac
}

#==============================================================================
# 播放列表管理
#==============================================================================
show_playlist() {
    if [[ ${#PLAYLIST[@]} -eq 0 ]]; then
        echo -e "\033[33m播放列表为空\033[0m"
        return
    fi
    
    echo ""
    echo "========================================"
    echo "         播放列表 (${#PLAYLIST[@]} 首)"
    echo "========================================"
    
    local i=0
    for track in "${PLAYLIST[@]}"; do
        local name="" artist="" album="" duration="" quality=""
        IFS='|' read -r name artist album duration _ quality _ _ _ <<< "$track"
        local qlabel
        case "$quality" in
            hires) qlabel="HiRes" ;; flac) qlabel="FLAC" ;; 320) qlabel="HQ" ;; 128) qlabel="SQ" ;; *) qlabel="--" ;;
        esac
        if [[ $i -eq $PLAYLIST_INDEX ]]; then
            echo -e "  \033[32m▶\033[0m $(printf '%2d' "$i") | $name | $artist | ${duration:---:--} | $qlabel"
        else
            echo -e "     $(printf '%2d' "$i") | $name | $artist | ${duration:---:--} | $qlabel"
        fi
        ((i++))
    done
    
    echo "========================================"
    echo "播放模式: $PLAY_MODE | 音量: $VOLUME%"
    echo ""
}

clear_playlist() {
    do_stop
    PLAYLIST=()
    LXMS_PLAYLIST=()
    PLAYLIST_INDEX=0
    echo -e "\033[32m✓ 播放列表已清空\033[0m"
}

# 追加一条统一轨道 (9/10 列兼容): name|artist|album|duration|song_id|quality|cover|quals|url|src
add_to_playlist() {
    local track="$1"
    PLAYLIST+=("$track")
    LXMS_PLAYLIST+=("$track")
}

# 将搜索结果行 (name|artist|album|duration|song_id|cover) 转为统一轨道并追加
add_search_result() {
    local line="$1"
    local source="${2:-}"
    local name="" artist="" album="" duration="" song_id="" cover=""
    IFS='|' read -r name artist album duration song_id cover <<< "$line"
    [[ -z "$name" ]] && return
    [[ -z "$source" ]] && source="${CURRENT_SOURCE:-${DEFAULT_SOURCE:-netease}}"
    add_to_playlist "$name|$artist|$album|$duration|$song_id||$cover|||$source"
}

