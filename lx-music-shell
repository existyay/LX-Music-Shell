BOLD='\033[1m'            # 加粗
DIM='\033[2m'             # 暗色
RED='\033[0;31m'          # 红色
GREEN='\033[0;32m'        # 绿色
YELLOW='\033[1;33m'       # 黄色
BLUE='\033[0;34m'         # 蓝色
MAGENTA='\033[0;35m'      # 洋红
CYAN='\033[0;36m'         # 青色
WHITE='\033[1;37m'        # 白色
GRAY='\033[0;90m'         # 灰色

#==============================================================================
# 配置目录
#==============================================================================
# 配置目录
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lx-music-shell"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/lx-music-shell"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lx-music-shell"
LIB_DIR="${DATA_DIR}/lib"

# 创建必要目录
mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR"

# 配置文件
CONFIG_FILE="$CONFIG_DIR/config"
SOURCES_FILE="$CONFIG_DIR/sources.list"
COOKIES_DIR="$CONFIG_DIR/cookies"
PLAYLIST_FILE="$CACHE_DIR/playlist.m3u"

# 默认配置
DEFAULT_PLAYER="mpv"
DEFAULT_SOURCE="kugou"
SEARCH_LIMIT=20

# 播放器状态
PLAYER_PID=""
PLAYER_STATUS="stopped"
PLAYER_BUFFERING="false"
CURRENT_TRACK=""
CURRENT_URL=""
CURRENT_SOURCE="$DEFAULT_SOURCE"
CURRENT_SOURCE_NAME=""
PLAYLIST=()
PLAYLIST_INDEX=0

# 播放模式
PLAY_MODE="${PLAY_MODE:-list}"
VOLUME="${VOLUME:-80}"

# 网络监控状态
NETWORK_STATUS="connected"      # connected | disconnected | reconnecting
LAST_CONNECTIVITY_CHECK=0
NETWORK_CHECK_INTERVAL=3        # 秒
RECONNECT_ATTEMPTS=0
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY=2               # 秒
WATCHDOG_PID=""

# 缓冲/播放进度
PLAYBACK_POSITION=0             # 秒
PLAYBACK_DURATION=0             # 秒
PLAYBACK_START_TIME=0

# 加载模块
load_modules() {
    # 优先使用安装目录的库
    local lib_path
    
    # 尝试多个可能的库目录
    for path in \
        "$(dirname "$0")/lib" \
        "/usr/local/share/lx-music-shell/lib" \
        "/usr/share/lx-music-shell/lib" \
        "$LIB_DIR"; do
        if [[ -d "$path" ]]; then
            lib_path="$path"
            break
        fi
    done
    
    if [[ -n "$lib_path" ]]; then
        # 加载模块
        [[ -f "$lib_path/player.sh" ]] && source "$lib_path/player.sh"
        [[ -f "$lib_path/search.sh" ]] && source "$lib_path/search.sh"
        [[ -f "$lib_path/ui.sh" ]] && source "$lib_path/ui.sh"
        [[ -f "$lib_path/download.sh" ]] && source "$lib_path/download.sh"
    fi
}

#==============================================================================
# 配置管理
#==============================================================================
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
    else
        save_config
    fi
    
    # 设置默认值
    PLAYER_BACKEND="${PLAYER_BACKEND:-$DEFAULT_PLAYER}"
    DEFAULT_SOURCE="${DEFAULT_SOURCE:-$DEFAULT_SOURCE}"
    SEARCH_LIMIT="${SEARCH_LIMIT:-20}"
    PLAY_MODE="${PLAY_MODE:-list}"
    VOLUME="${VOLUME:-80}"
}

save_config() {
    cat > "$CONFIG_FILE" << EOF
# LX-Music-Shell 配置文件
# 自动生成

# 播放器后端 (mpv/mplayer/ffplay)
PLAYER_BACKEND="$PLAYER_BACKEND"

# 默认音乐源
DEFAULT_SOURCE="$DEFAULT_SOURCE"

# 搜索结果数量限制
SEARCH_LIMIT="$SEARCH_LIMIT"

# 播放模式 (list/loop/single/random)
PLAY_MODE="$PLAY_MODE"

# 音量 (0-100)
VOLUME="$VOLUME"

# 自动更新源列表
AUTO_UPDATE_SOURCES="${AUTO_UPDATE_SOURCES:-true}"

# UI设置
