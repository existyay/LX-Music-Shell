    echo "来源: ${CURRENT_SOURCE_NAME:-$CURRENT_SOURCE}"
    echo "播放模式: $PLAY_MODE"
    echo "音量: $VOLUME%"
    echo "播放器: $backend"
    echo "播放列表: ${#PLAYLIST[@]} 首"
    echo "当前索引: $PLAYLIST_INDEX"
    echo "========================================"
    echo ""
}

