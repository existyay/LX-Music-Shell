#!/usr/bin/env bash
#==============================================================================
# LX-Music-Shell - 终端音乐播放器
# 基于 LX-Music-Desktop 和 go-music-fox 设计
# 版本: 2.0.0
#
# 支持两种 UI 模式:
#   1) CLI 模式 (默认): 命令行交互 (向后兼容 v1.x)
#   2) TUI 模式 (--tui): 图形化分栏界面 + 键盘/鼠标
#
# TUI 模式会检测终端能力自动启用:
#   - 终端列数 >= 60 且 行数 >= 20 -> 启用 TUI
#   - kitty/iTerm/sixel -> 封面图显示
#   - SGR 1006 鼠标 -> 鼠标点选
#==============================================================================

# 版本信息
VERSION="3.4.0"

# 优雅退出处理：在收到中断或终止信号时尝试停止播放器
on_exit() {
    if [[ "${LXMS_PLAYER_HANDLED:-0}" != "1" ]]; then
        # 后台播放模式: 有音乐播放时保留 mpv 继续运行, 只清理看护/状态栏任务
        if [[ "${BACKGROUND_PLAY:-true}" == "true" ]] && declare -f player_is_running >/dev/null 2>&1 && player_is_running; then
            if declare -f save_player_background_state >/dev/null 2>&1; then
                save_player_background_state >/dev/null 2>&1 || true
            fi
            if declare -f stop_watchdog >/dev/null 2>&1; then stop_watchdog; fi
            if declare -f stop_status_bar >/dev/null 2>&1; then stop_status_bar; fi
            disown "$PLAYER_PID" 2>/dev/null || true
        else
            # 优先走统一清理 (含后台网络监控/状态栏), 避免退出后残留后台任务写终端
            if declare -f cleanup_player >/dev/null 2>&1; then
                cleanup_player >/dev/null 2>&1 || true
            elif declare -f player_stop >/dev/null 2>&1; then
                player_stop >/dev/null 2>&1 || true
            elif declare -f do_stop >/dev/null 2>&1; then
                do_stop >/dev/null 2>&1 || true
            fi
        fi
    fi
    # 恢复终端状态 (TUI 模式可能改动了)
    if [[ "${LXMS_TUI_ACTIVE:-0}" == "1" ]]; then
        if declare -f input_disable_mouse >/dev/null 2>&1; then
            input_disable_mouse 2>/dev/null || true
        fi
        if declare -f tui_cleanup >/dev/null 2>&1; then
            tui_cleanup 2>/dev/null || true
        fi
        stty sane 2>/dev/null || true
        LXMS_TUI_ACTIVE=0
    fi
}
trap 'on_exit' EXIT
trap 'on_exit; exit 130' INT
trap 'on_exit; exit 143' TERM

