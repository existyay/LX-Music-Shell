示例:
  /s 周杰伦
  /play 1
  /source netease
  /mode loop
  /test-sources

========================================
EOF
}

#==============================================================================
# 交互模式
#==============================================================================
interactive_mode() {
    clear
    echo -e "\033[36m"
    echo ""
    echo "   ╔═══════════════════════════════════════╗"
    echo "   ║     LX-Music-Shell v$VERSION              ║"
    echo "   ║  Terminal Music Player              ║"
    echo "   ╚═══════════════════════════════════════╝"
    echo -e "\033[0m"
    echo "欢迎使用 LX-Music-Shell"
    echo "输入 /help 查看命令帮助"
    echo ""
    
    while true; do
        echo -n -e "\033[32mlx>\033[0m "
        read -r cmd args
        
        if [[ -z "$cmd" ]]; then
            continue
        fi
        
        # 解析并执行命令
        case "$cmd" in
            /help|/h)
                show_help
                ;;
            /search|/s)
                do_search "$args"
                ;;
            /play|/p)
                do_play "$args"
                ;;
            /pause)
                do_pause
                ;;
            /resume|/r)
                do_resume
                ;;
            /stop)
                do_stop
                ;;
            /next|/n)
                do_next
                ;;
            /prev)
                do_prev
                ;;
            /list|/l)
                show_playlist
                ;;
            /clear)
                clear_playlist
                ;;
            /mode)
                set_play_mode "$args"
                ;;
            /volume|/v)
                set_volume "$args"
                ;;
            /source|/src)
                DEFAULT_SOURCE="$args"
                echo "已切换到: $args"
                ;;
            /test-sources)
                test_all_sources
                ;;
            /update-sources)
                fetch_source_api
                ;;
            /import-source)
                import_source "$args"
                ;;
            /status)
                show_status
                ;;
            /config)
                echo "当前配置:"
                echo "  播放器: $PLAYER_BACKEND"
                echo "  默认源: $DEFAULT_SOURCE"
                echo "  搜索限制: $SEARCH_LIMIT"
                echo "  播放模式: $PLAY_MODE"
                echo "  音量: $VOLUME%"
                ;;
            /quit|/q|exit)
                do_stop
                echo "再见！"
                break
                ;;
            *)
                # 非命令视为搜索
                do_search "$cmd $args"
                ;;
        esac
    done
}

#==============================================================================
# 命令行模式
#==============================================================================
command_mode() {
    local cmd="$1"
    shift
    
    case "$cmd" in
        search|-s|--search)
            do_search "$@"
            ;;
        test-sources|--test-sources)
            test_all_sources
            ;;
        update-sources|--update-sources)
            fetch_source_api
            ;;
        import-source|--import-source)
            import_source "$1"
            ;;
        help|-h|--help)
            show_help
            ;;
        version|-v|--version)
            echo "LX-Music-Shell v$VERSION"
            ;;
        *)
            echo "未知命令: $cmd"
            echo "使用 --help 查看帮助"
            exit 1
            ;;
    esac
}

#==============================================================================
# 主程序入口
#==============================================================================
main() {
    # 加载配置和模块
    load_config
    load_sources
    load_modules
    
    # 解析命令行参数
    if [[ $# -eq 0 ]]; then
        interactive_mode
    else
        command_mode "$@"
    fi
}

main "$@"
