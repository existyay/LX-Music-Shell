# 动画1: 加载旋转器 (spinner)
show_spinner() {
    local duration="${1:-2}"
    local message="${2:-加载中}"
    local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local colors=("\033[36m" "\033[32m" "\033[33m" "\033[35m")
    
    local end_time=$(($(date +%s) + duration))
    local i=0
    
    hide_cursor
    
    while [[ $(date +%s) -lt $end_time ]]; do
        local frame="${frames[$((i % ${#frames[@]}))]}"
        local color="${colors[$((i % ${#colors[@]}))]}"
        
        printf '%b' "\r${color}${frame}${NC} ${message}..."
        sleep 0.08
        ((i++))
    done
    
    printf '%b\n' "\r${GREEN}✓${NC} ${message}"
    show_cursor
}

# 动画2: 进度条加载
show_progress() {
    local duration="${1:-2}"
    local message="${2:-正在初始化}"
    local width=30
    
    hide_cursor
    
    local end_time=$(($(date +%s) + duration))
    local total_steps=20
    local step_duration
    step_duration=$(echo "scale=4; $duration / $total_steps" | bc 2>/dev/null || echo "0.1")
    
    for ((step=0; step<=total_steps; step++)); do
        local percent=$((step * 100 / total_steps))
        local filled=$((step * width / total_steps))
        local remaining=$((width - filled))
        
        printf '%b' "\r  ${CYAN}["
        printf "${GREEN}%${filled}s" '' | tr ' ' '█'
        printf "${GRAY}%${remaining}s" '' | tr ' ' '░'
        printf '%b %3d%% %s' "${CYAN}]${NC}" "$percent" "${message}"
        
        sleep "$step_duration"
    done
    
    printf '%b\n' "\r  ${GREEN}[$(printf '█%.0s' $(seq 1 $width))] 100%% ${message}${NC}"
    show_cursor
}

