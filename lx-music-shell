#!/usr/bin/env bash
#==============================================================================
# LX-Music-Shell - 终端音乐播放器
# 基于 LX-Music-Desktop 和 go-music-fox 设计
# 版本: 1.1.0
#==============================================================================

# 版本信息
VERSION="1.1.0"
PROGRAM_NAME="lx-music-shell"

# 优雅退出处理：在收到中断或终止信号时尝试停止播放器
on_exit() {
    # 如果 do_stop 已定义，尝试优雅停止播放器
    if declare -f do_stop >/dev/null 2>&1; then
        do_stop >/dev/null 2>&1 || true
    fi
}
trap 'on_exit' INT TERM

