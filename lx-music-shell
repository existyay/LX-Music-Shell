    local backend
    backend=$(get_player_backend) || backend="未安装"
    
    # 计算播放进度
    local position=0
    if [[ "$PLAYER_STATUS" == "playing" ]] && [[ $PLAYBACK_START_TIME -gt 0 ]]; then
        position=$(($(date +%s) - PLAYBACK_START_TIME))
    fi
    local position_str
    position_str=$(format_time "$position")
    local duration_str
    duration_str=$(format_time "$PLAYBACK_DURATION")
    
    # 网络状态描述
    local net_desc
    case "$NETWORK_STATUS" in
        connected)
            net_desc="● 已连接"
            ;;
        disconnected)
            net_desc="○ 已断开"
            ;;
        reconnecting)
            net_desc="⟳ 重连中 ($RECONNECT_ATTEMPTS/$MAX_RECONNECT_ATTEMPTS)"
            ;;
        *)
            net_desc="? 未知"
            ;;
    esac
    
    echo ""
    echo "========================================"
    echo "         播放器状态"
    echo "========================================"
    echo "状态: $PLAYER_STATUS"
    echo "进度: $position_str / $duration_str"
    echo "当前歌曲: ${CURRENT_TRACK:-无}"
    echo "来源: ${CURRENT_SOURCE_NAME:-$CURRENT_SOURCE}"
