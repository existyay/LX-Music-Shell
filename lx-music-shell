import_source() {
    local source_file="$1"
    
    if [[ ! -f "$source_file" ]]; then
        echo -e "\033[31m错误: 文件不存在: $source_file\033[0m"
        return 1
    fi
    
    if grep -qE '^SOURCE_[A-Z]+=' "$source_file"; then
        cp "$SOURCES_FILE" "$SOURCES_FILE.bak" 2>/dev/null || true
        cat "$source_file" >> "$SOURCES_FILE"
        echo -e "\033[32m✓ 源配置已导入\033[0m"
    else
        echo -e "\033[31m错误: 无效的源配置格式\033[0m"
        return 1
    fi
}

#==============================================================================
# 播放模式
#==============================================================================
set_play_mode() {
    local mode="$1"
    
    case "$mode" in
        list|loop|single|random)
            PLAY_MODE="$mode"
            echo -e "\033[32m播放模式: $PLAY_MODE\033[0m"
            ;;
        *)
            echo "播放模式: $PLAY_MODE"
            echo "可用: list, loop, single, random"
            ;;
    esac
}

#==============================================================================
# 音量控制
#==============================================================================
set_volume() {
    local vol="$1"
    
    if [[ -z "$vol" ]]; then
        echo "当前音量: $VOLUME%"
        return
    fi
    
    if ! [[ "$vol" =~ ^[0-9]+$ ]] || [[ $vol -lt 0 ]] || [[ $vol -gt 100 ]]; then
        echo -e "\033[31m错误: 音量值无效 (0-100)\033[0m"
        return 1
    fi
    
    VOLUME=$vol
    echo -e "\033[32m音量: $VOLUME%\033[0m"
}

#==============================================================================
# 播放器状态
#==============================================================================
show_status() {
    local backend
    backend=$(get_player_backend) || backend="未安装"
    
    echo ""
    echo "========================================"
    echo "         播放器状态"
    echo "========================================"
    echo "状态: $PLAYER_STATUS"
