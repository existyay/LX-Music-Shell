            songs=("稻香|周杰伦|魔杰座|03:42|c5eff3b741e5e1dc|")
            ;;
        *)
            songs=("${query}_演示1|未知|示例|03:00|null|" "${query}_演示2|未知|示例|04:00|null|")
            ;;
    esac
    local count=0
    for song in "${songs[@]}"; do
        ((count++))
        [[ $count -gt $limit ]] && break
        printf '%s\n' "$song"
    done
}

# 用单个源搜索并把结果追加到播放列表 (不清空)
search_append_source() {
    local query="$1" source="$2" limit="$3"
    local src results
    src=$(normalize_source_id "$source")
    results=""
    # 1) 内置源优先 (有注册搜索函数: netease 直连 / kugou..migu 走 LX API)
    if declare -F "${src}_search" >/dev/null 2>&1; then
        results=$("${src}_search" "$query" "$limit" 2>/dev/null)
    # 2) 否则若是用户自定义源 (在 sources.list 配置的 URL 模板)
    elif [[ -n "${SOURCE_URLS[$source]:-}" ]]; then
        results=$(search_custom_source "$query" "$source" "$limit" 2>/dev/null)
    fi
    [[ -z "$results" ]] && results=$(search_mock_emit "$src" "$query" "$limit" 2>/dev/null)

    local n=0
    if [[ -n "$results" ]]; then
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            add_search_result "$line" "$src"
            ((n++))
            [[ $n -ge $limit ]] && break
        done <<< "$results"
    fi
}

# 核心搜索: 清空旧结果并搜索单个源
run_search_core() {
    local query="$1" source="$2" limit="$3"
    PLAYLIST=()
    LXMS_PLAYLIST=()
    PLAYLIST_INDEX=0
    UI_SELECTED=0
    # shellcheck disable=SC2034  # TUI 滚动状态供 tui.sh 读取
    UI_SCROLL_TOP=0
    search_append_source "$query" "$source" "$limit"
}

# 同步搜索单个源, 输出 6 列结果 (无结果则不输出)
_search_one_source_sync() {
    local src="$1" query="$2" limit="${3:-5}"
    if declare -F "${src}_search" >/dev/null 2>&1; then
        "${src}_search" "$query" "$limit" 2>/dev/null
    elif [[ -n "${SOURCE_URLS[$src]:-}" ]]; then
        search_custom_source "$query" "$src" "$limit" 2>/dev/null
    fi
}

# 后台搜索单个源并写入临时文件
_search_one_source_to_file() {
    local src="$1" query="$2" limit="$3" out="$4" results
    results="$(_search_one_source_sync "$src" "$query" "$limit" 2>/dev/null)"
    [[ -n "$results" ]] && printf '%s\n' "$results" > "$out"
}

# 自动匹配搜索: 并行测试所有可用源 (内置 + yinyuan/自定义), 无感聚合结果
do_search_auto() {
    local query="$1" limit="${2:-$SEARCH_LIMIT}"
    [[ -z "$query" ]] && return 1

    local -a candidates srcs pids files
    local src name tmpd out i
    for src in netease kugou kuwo qq migu; do
        source_is_available "$src" && candidates+=("$src")
    done
    for name in $(printf '%s\n' "${!SOURCE_URLS[@]}" | sort); do
        case "$name" in
            netease|kugou|kuwo|qq|migu|ximalaya) continue ;;
        esac
        source_is_available "$name" && candidates+=("$name")
    done
    [[ ${#candidates[@]} -eq 0 ]] && return 1

    tmpd=$(mktemp -d "${TMPDIR:-/tmp}/lxms-search.XXXXXX") || return 1
    i=0
    for src in "${candidates[@]}"; do
        out="$tmpd/$i.out"
        _search_one_source_to_file "$src" "$query" "$limit" "$out" &
        srcs+=("$src"); pids+=("$!"); files+=("$out")
        i=$((i + 1))
    done

    # 最多等待 12 秒, 未完成的源自动放弃 (无感)
    local deadline=$((SECONDS + 12)) alive pid
    while :; do
        alive=0
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then alive=1; break; fi
        done
        [[ $alive -eq 0 ]] && break
        (( SECONDS >= deadline )) && break
        sleep 0.1
    done
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    wait 2>/dev/null || true

    PLAYLIST=(); LXMS_PLAYLIST=(); PLAYLIST_INDEX=0
    UI_SELECTED=0; UI_SCROLL_TOP=0
    local n=0 idx=0 line
    for src in "${srcs[@]}"; do
        local file="${files[idx]}"
        idx=$((idx + 1))
        [[ -s "$file" ]] || continue
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            [[ $n -ge $limit ]] && break 2
            add_search_result "$line" "$src"
            ((n++))
        done < "$file"
    done
    rm -rf "$tmpd"

    CURRENT_SOURCE="auto"
    CURRENT_SOURCE_NAME="自动匹配"
    echo -e "\033[32m✓ 自动匹配 ${n} 首 (测试 ${#srcs[@]} 个源, 无感切换可用源)\033[0m"
    return 0
}

# 播放失败时自动尝试其他源解析 (无感回退)
_auto_resolve_url() {
    local name="$1" artist="$2" original_src="$3"
    local -a candidates
    local src
    for src in netease kugou kuwo qq migu; do
        [[ "$src" == "$original_src" ]] && continue
        source_is_available "$src" && candidates+=("$src")
    done
    for src in $(printf '%s\n' "${!SOURCE_URLS[@]}" | sort); do
        case "$src" in
            netease|kugou|kuwo|qq|migu|ximalaya) continue ;;
        esac
        [[ "$src" == "$original_src" ]] && continue
        source_is_available "$src" && candidates+=("$src")
    done

    local c line n sid2 qr q u
    for c in "${candidates[@]}"; do
        declare -F "${c}_search" >/dev/null 2>&1 || continue
        local results
        results="$(_search_one_source_sync "$c" "$name $artist" 5 2>/dev/null)"
        [[ -z "$results" ]] && continue
        while IFS= read -r line; do
            IFS='|' read -r n _ _ _ sid2 _ <<< "$line"
            [[ -z "$sid2" || "$sid2" == "null" ]] && continue
            qr=$(source_base_get_play_url "$c" "$sid2" "${DEFAULT_QUALITY:-flac}" 2>/dev/null) || continue
            q="${qr%%:*}"
            u="${qr#*:}"
            [[ "$u" == http* ]] || continue
            printf '%s|%s|%s' "$c" "$q" "$u"
            return 0
        done <<< "$results"
    done
    return 1
}

do_search() {
    local query="$1"
    local source="$DEFAULT_SOURCE"
    local limit="$SEARCH_LIMIT"

    if [[ -z "$query" ]]; then
        echo -e "\033[31m错误: 请输入搜索关键词\033[0m"
        return 1
    fi

    # 未显式指定源时, 自动测试并聚合所有可用源 (含 yinyuan 内嵌源)
    if [[ -z "$2" ]]; then
        do_search_auto "$query" "$limit"
        return $?
    fi

    # 第二参数是内置源名或已配置的自定义源名 -> 指定源; 数字 -> limit
    if [[ -n "$2" ]] && { [[ "$2" =~ ^(netease|wy|kg|kugou|kw|kuwo|tx|qq|mg|migu|all|ximalaya)$ ]] || [[ -n "${SOURCE_URLS[$2]:-}" ]]; }; then
        source="$2"
        [[ -n "$3" ]] && [[ "$3" =~ ^[0-9]+$ ]] && limit="$3"
    elif [[ -n "$2" ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
        limit="$2"
    fi

    if [[ "$source" == "all" ]]; then
        local sub=$((limit / 5 + 1))
        PLAYLIST=(); LXMS_PLAYLIST=(); PLAYLIST_INDEX=0
        local s
        for s in netease kugou kuwo qq migu; do
            search_append_source "$query" "$s" "$sub"
        done
        CURRENT_SOURCE="all"
        CURRENT_SOURCE_NAME="聚合搜索"
    else
        run_search_core "$query" "$source" "$limit"
        CURRENT_SOURCE="$source"
        case "$source" in
            netease|wy) CURRENT_SOURCE_NAME="网易云音乐" ;;
            kugou|kg)   CURRENT_SOURCE_NAME="酷狗音乐" ;;
            kuwo|kw)    CURRENT_SOURCE_NAME="酷我音乐" ;;
            qq|tx)      CURRENT_SOURCE_NAME="QQ音乐" ;;
            migu|mg)    CURRENT_SOURCE_NAME="咪咕音乐" ;;
            ximalaya)   CURRENT_SOURCE_NAME="喜马拉雅" ;;
            *)
                if [[ -n "${SOURCE_URLS[$source]:-}" ]]; then
                    CURRENT_SOURCE_NAME="自定义源 $source"
                else
                    CURRENT_SOURCE_NAME="$source"
                fi
                ;;
        esac
    fi

    echo -e "\033[32m✓ 找到 ${#PLAYLIST[@]} 首 (源: ${CURRENT_SOURCE_NAME})\033[0m"
    return 0
}

