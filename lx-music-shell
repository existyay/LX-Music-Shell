#==============================================================================
# 交互模式
#==============================================================================
interactive_mode() {
    # 初始化终端
    init_terminal
    
    # 显示开屏动画
    show_splash_animation
    
    echo ""
    
    while true; do
        echo -n -e "\033[32mlx>\033[0m "
        if ! read -r cmd args; then
            # EOF (Ctrl+D) - 退出交互模式
            echo ""
            break
        fi

        if [[ -z "$cmd" ]]; then
            continue
        fi
        
        # 解析并执行命令
        case "$cmd" in
            /help|/h)
                show_help
                ;;
            /search|/s)
                do_search "$args"
                ;;
            /play|/p)
                do_play "$args"
                ;;
            /pause)
                do_pause
                ;;
            /resume|/r)
                do_resume
                ;;
            /stop)
                do_stop
                ;;
            /next|/n)
                do_next
                ;;
            /prev)
                do_prev
                ;;
            /list|/l)
                show_playlist
                ;;
            /clear)
                clear_playlist
                ;;
            /mode)
                set_play_mode "$args"
                ;;
            /volume|/v)
                set_volume "$args"
                ;;
            /source|/src)
                DEFAULT_SOURCE="$args"
                echo "已切换到: $args"
                ;;
            /test-sources)
                test_all_sources
                ;;
            /update-sources)
                fetch_source_api
                ;;
            /import-source)
                import_source "$args"
                ;;
            /status)
                show_status
                ;;
            /statusbar)
                render_status_bar
                ;;
            /network)
                echo "检查网络状态..."
                if check_connectivity; then
                    echo -e "\033[32m✓ 网络已连接\033[0m"
                    NETWORK_STATUS="connected"
                else
                    echo -e "\033[31m✗ 网络已断开\033[0m"
                    NETWORK_STATUS="disconnected"
                fi
                ;;
            /reconnect)
                echo "手动尝试重连..."
                handle_network_loss
                ;;
            /config)
                echo "当前配置:"
                echo "  播放器: $PLAYER_BACKEND"
                echo "  默认源: $DEFAULT_SOURCE"
                echo "  搜索限制: $SEARCH_LIMIT"
                echo "  播放模式: $PLAY_MODE"
                echo "  音量: $VOLUME%"
                ;;
            /quit|/q|exit)
                do_stop
                echo "再见！"
                break
                ;;
            *)
                # 非命令视为搜索
                do_search "$cmd $args"
                ;;
        esac
    done
}

#==============================================================================
# 命令行模式
#==============================================================================
command_mode() {
    local cmd="$1"
    shift
    
    case "$cmd" in
        search|-s|--search)
            do_search "$@"
            ;;
        test-sources|--test-sources)
            test_all_sources
            ;;
        update-sources|--update-sources)
            fetch_source_api
            ;;
        import-source|--import-source)
            import_source "$1"
            ;;
        help|-h|--help)
            show_help
            ;;
        version|-v|--version)
            echo "LX-Music-Shell v$VERSION"
            ;;
        *)
            echo "未知命令: $cmd"
            echo "使用 --help 查看帮助"
            exit 1
            ;;
    esac
}

#==============================================================================
# 主程序入口
#==============================================================================
main() {
    # 加载配置和模块
    load_config
    load_sources
    load_modules
    
    # 解析命令行参数
    if [[ $# -eq 0 ]]; then
        interactive_mode
    else
        command_mode "$@"
    fi
}

main "$@"
