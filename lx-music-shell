#==============================================================================
# 源配置管理
#==============================================================================
load_sources() {
    SOURCE_URLS=()

    if [[ -f "$SOURCES_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$SOURCES_FILE"
    fi

    for var in $(compgen -v | grep '^SOURCE_' | sort); do
        local key="${var#SOURCE_}"
        local url="${!var}"
        if [[ -n "$url" ]]; then
            local lower_key="${key,,}"
            SOURCE_URLS["$lower_key"]="$url"
        fi
    done

    # 加载 yinyuan 目录中混淆加密的自定义音源 (解混淆后注入内存, 不落盘明文)
    if declare -F yinyuan_list >/dev/null 2>&1; then
        local yn yurl
        while IFS= read -r yn; do
            [[ -z "$yn" ]] && continue
            yurl=$(yinyuan_get_url "$yn" 2>/dev/null)
            [[ -n "$yurl" ]] && SOURCE_URLS["$yn"]="$yurl"
        done < <(yinyuan_list)
    fi
}

show_sources() {
    echo ""
    echo "========================================"
    echo "       已配置音乐源"
    echo "========================================"

    if [[ ${#SOURCE_URLS[@]} -eq 0 ]]; then
        echo "  (未检测到配置源，使用 /update-sources 生成默认源)"
        return
    fi

    for name in $(printf '%s\n' "${!SOURCE_URLS[@]}" | sort); do
        echo "  $name => ${SOURCE_URLS[$name]}"
    done

    echo ""
    echo "当前默认源: $DEFAULT_SOURCE"
    echo "使用 /source add <name> <url> 添加自定义源"
    echo "使用 /source remove <name> 删除自定义源"
}

add_source() {
    local name="${1,,}"
    local url="$2"

    if [[ -z "$name" ]] || [[ -z "$url" ]]; then
        echo -e "\033[31m错误: 用法 /source add <名称> <URL 或 GitHub链接>\033[0m"
        return 1
    fi

    if [[ "$name" =~ [^a-z0-9_-] ]]; then
        echo -e "\033[31m错误: 源名称只能包含小写字母、数字、下划线和中划线\033[0m"
        return 1
    fi

    # 验证 URL 格式，防止意外的恶意输入
    if [[ ! "$url" =~ ^https?:// ]]; then
        echo -e "\033[31m错误: URL 必须以 http:// 或 https:// 开头\033[0m"
        return 1
    fi

    # 若为 GitHub 链接, 自动拉取配置 (内容 = 搜索 URL 模板或 JSON)
    if declare -F yinyuan_is_github_url >/dev/null 2>&1 && yinyuan_is_github_url "$url"; then
        echo -e "\033[36m检测到 GitHub 链接, 拉取音源配置...\033[0m"
        local fetched
        fetched=$(yinyuan_fetch_github "$url" 2>/dev/null)
        if [[ -z "$fetched" ]] || [[ "$fetched" != http* ]]; then
            echo -e "\033[31m错误: 无法从该 GitHub 链接解析出有效搜索 URL\033[0m"
            return 1
        fi
        url="$fetched"
        echo -e "\033[2m  解析到搜索 URL 模板\033[0m"
    fi

    # 混淆加密存储到 yinyuan 目录 (不落盘明文 URL)
    if declare -F yinyuan_add >/dev/null 2>&1; then
        yinyuan_add "$name" "$url" || { echo -e "\033[31m错误: 音源加密存储失败\033[0m"; return 1; }
    else
        # 兜底: 无 yinyuan 模块时写回旧式 sources.list
        local varname="SOURCE_${name^^}"
        [[ -f "$SOURCES_FILE" ]] || : > "$SOURCES_FILE"
        if grep -qE "^${varname}=" "$SOURCES_FILE" 2>/dev/null; then
            sed -i "s|^${varname}=.*|${varname}=\"$url\"|" "$SOURCES_FILE"
        else
            echo "${varname}=\"$url\"" >> "$SOURCES_FILE"
        fi
    fi
    SOURCE_URLS["$name"]="$url"
    echo -e "\033[32m✓ 已添加音源: $name (加密存储于 yinyuan/)\033[0m"
}

remove_source() {
    local name="${1,,}"

    if [[ -z "$name" ]]; then
        echo -e "\033[31m错误: 用法 /source remove <名称>\033[0m"
        return 1
    fi

    # 从 yinyuan 目录移除
    local removed=0
    if declare -F yinyuan_exists >/dev/null 2>&1 && yinyuan_exists "$name"; then
        yinyuan_remove "$name"
        removed=1
    fi

    # 兼容旧式 sources.list
    local varname="SOURCE_${name^^}"
    if grep -qE "^${varname}=" "$SOURCES_FILE" 2>/dev/null; then
        sed -i "/^${varname}=.*/d" "$SOURCES_FILE"
        removed=1
    fi

    if [[ $removed -eq 0 ]]; then
        echo -e "\033[33m警告: 源 '$name' 不存在\033[0m"
        return 1
    fi

    unset "SOURCE_URLS[$name]"
    unset "${varname}" 2>/dev/null || true
    echo -e "\033[32m✓ 已删除源: $name\033[0m"
}

# URL 编码 (用 python3, 正确处理 UTF-8)
url_encode() {
    python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1" 2>/dev/null || printf '%s' "$1"
}

format_custom_search_url() {
    local query="$1"
    local source="$2"
    local limit="${3:-$SEARCH_LIMIT}"
    local url_template="${SOURCE_URLS[$source]}"
    local encoded_query
    encoded_query=$(url_encode "$query")
    local search_url

    search_url="${url_template//\{\{query\}\}/$encoded_query}"
    search_url="${search_url//\{\{limit\}\}/$limit}"

    if [[ "$search_url" == "$url_template" ]]; then
        if [[ "$search_url" == *\?* ]]; then
            search_url="$search_url&q=$encoded_query&limit=$limit"
        else
            search_url="$search_url?q=$encoded_query&limit=$limit"
        fi
    fi

    printf '%s' "$search_url"
}

# 自定义源搜索: 拉取并解析 JSON 响应, 输出标准 6 列 (name|artist|album|duration|song_id|cover)
search_custom_source() {
    local query="$1"
    local source="$2"
    local limit="${3:-$SEARCH_LIMIT}"
    local url_template="${SOURCE_URLS[$source]}"

    if [[ -z "$query" ]] || [[ -z "$url_template" ]]; then
        return 1
    fi

    local search_url resp
    search_url=$(format_custom_search_url "$query" "$source" "$limit")
    resp=$(curl -s --connect-timeout 8 --max-time 20 "$search_url" 2>/dev/null)
    [[ -z "$resp" ]] && return 1

    # 用 python3 泛化解析常见 JSON 响应 (无 jq 依赖)
    printf '%s' "$resp" | python3 -c '
import sys, json
def fmt_dur(ms):
    try:
        s = int(ms) // 1000
    except Exception:
        return "00:00"
    if s < 0:
        return "00:00"
    return "%02d:%02d" % (s // 60, s % 60)
def g(item, *keys):
    for k in keys:
        v = item.get(k)
        if v is not None and v != "":
            return v
    return ""
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
songs = None
if isinstance(d, list):
    songs = d
elif isinstance(d, dict):
    for k in ("data", "songs", "list", "result", "results", "tracks", "songList"):
        v = d.get(k)
        if isinstance(v, list):
            songs = v; break
    if songs is None:
        for outer in (d.get("data"), d.get("result")):
            if isinstance(outer, dict):
                for k in ("songs", "list", "tracks", "songList"):
                    if isinstance(outer.get(k), list):
                        songs = outer[k]; break
            if songs:
                break
if not songs:
    sys.exit(1)
for item in songs:
    if not isinstance(item, dict):
        continue
    name = g(item, "name", "songname", "songName", "title", "song", "trackName") or "未知"
    artist = g(item, "singer", "artist", "author", "singerName", "artists", "artistName")
    if isinstance(artist, list):
        artist = (artist[0].get("name") if isinstance(artist[0], dict) else artist[0]) if artist else ""
    artist = artist or "未知歌手"
    album = g(item, "album", "albumName", "albumname", "collectionName") or ""
    dur = fmt_dur(g(item, "duration", "Duration", "interval", "dt", "trackTimeMillis", 0))
    sid = str(g(item, "id", "songId", "songid", "rid", "hash", "songmid", "song_id", "trackId") or "")
    cover = g(item, "picUrl", "cover", "coverUrl", "albumPic", "img", "pic", "artworkUrl100") or ""
    print("|".join([name, artist, album, dur, sid, cover]))
' 2>/dev/null | head -n "$limit"
}

set_source() {
    local action="$1"
    shift

    case "$action" in
        ""|list)
            show_sources
            show_yinyuan_sources
            ;;
        add)
            add_source "$@"
            ;;
        remove|rm|del)
            remove_source "$1"
            ;;
        select)
            yinyuan_select
            ;;
        *)
            local normalized
            normalized=$(normalize_source_id "${action,,}")
            if source_is_available "$normalized"; then
                DEFAULT_SOURCE="$normalized"
                CURRENT_SOURCE="$normalized"
                CURRENT_SOURCE_NAME="$(source_display_name "$normalized")"
                save_config
                echo -e "\033[32m已切换到源: ${CURRENT_SOURCE_NAME} (${normalized})\033[0m"
            else
                echo -e "\033[31m错误: 未知或不可用音源 '$action'\033[0m"
                echo "可用: /source list 查看; 自定义源用 /source add <name> <url> 添加"
            fi
            ;;
    esac
}

#==============================================================================
# 音质切换 (CLI: /quality [hires|flac|320|128])
#==============================================================================
set_quality() {
    local q="$1"
    if [[ -z "$q" ]]; then
        echo "当前音质: ${DEFAULT_QUALITY:-flac}"
        echo "可用: hires, flac, 320, 128"
        return 0
    fi
    case "$q" in
        hires|flac|320|128)
            DEFAULT_QUALITY="$q"
            save_config
            echo -e "\033[32m已切换到音质: $(quality_label "$q") ($q)\033[0m"
            ;;
        *)
            echo -e "\033[31m错误: 无效音质 '$q' (可用: hires, flac, 320, 128)\033[0m"
            return 1
            ;;
    esac
}

# 显示 yinyuan 内置精选源 (选择式加入入口)
show_yinyuan_sources() {
    if ! declare -f yinyuan_curated >/dev/null 2>&1; then
        return 0
    fi
    echo ""
    echo "----------------------------------------"
    echo "  内置精选音源 (选择式加入: /source select)"
    echo "----------------------------------------"
    while IFS='|' read -r yn_name yn_desc _; do
        [[ -z "$yn_name" ]] && continue
        local mark="  "
        yinyuan_exists "$yn_name" 2>/dev/null && mark="✓ "
        printf '  %s%-12s %s\n' "$mark" "$yn_name" "$yn_desc"
    done < <(yinyuan_curated)
    echo "  自定义音源: /source add <名称> <URL或GitHub链接>"
}

# 选择式添加音源 (交互)
yinyuan_select() {
    if ! declare -f yinyuan_curated >/dev/null 2>&1; then
        echo -e "\033[31m错误: 音源管理模块未加载\033[0m"
        return 1
    fi

    echo ""
    echo "可选音源 (输入序号或名称):"
    local -a names=() descs=()
    local i=1 name desc
    while IFS='|' read -r name desc _; do
        [[ -z "$name" ]] && continue
        names+=("$name")
        descs+=("$desc")
        printf '  %d. %-10s %s\n' "$i" "$name" "$desc"
        ((i++))
    done < <(yinyuan_curated)

    echo -n "选择: "
    read -r choice
    local sel_idx=-1
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#names[@]} )); then
        sel_idx=$((choice - 1))
    else
        local j
        for ((j = 0; j < ${#names[@]}; j++)); do
            [[ "${names[j]}" == "$choice" ]] && { sel_idx=$j; break; }
        done
    fi

    if [[ $sel_idx -lt 0 ]]; then
        echo -e "\033[31m无效选择\033[0m"
        return 1
    fi

    local sel_name="${names[sel_idx]}"
    echo -n "输入 $sel_name 的搜索 URL 或 GitHub raw 链接 (回车跳过): "
    read -r url
    if [[ -z "$url" ]]; then
        echo -e "\033[33m已跳过 (内置源如网易云音乐已直连, 无需自定义)\033[0m"
        return 0
    fi
    add_source "$sel_name" "$url"
}

#==============================================================================
# 播放器后端选择
#==============================================================================
get_player_backend() {
    local backend="${PLAYER_BACKEND:-mpv}"
    
    for player in "$backend" mpv ffplay mplayer; do
        if command -v "$player" &>/dev/null; then
            echo "$player"
            return 0
        fi
    done
    
    return 1
}

#==============================================================================
# 网络状态监控 (蓝牙断线、网络中断自动重连)
#==============================================================================

# 检测网络连接
check_connectivity() {
    # 检查多个主机，确保准确判断
    local hosts=("8.8.8.8" "1.1.1.1" "223.5.5.5")
    
    for host in "${hosts[@]}"; do
        if timeout 2 ping -c 1 -W 2 "$host" &>/dev/null; then
            return 0
        fi
    done
    
    return 1
}

# 网络监控循环 (后台守护进程)
network_watchdog() {
    while true; do
        sleep "$NETWORK_CHECK_INTERVAL"
        
        # 只在播放中检查网络
        if [[ "$PLAYER_STATUS" != "playing" ]]; then
            continue
        fi
        
        if check_connectivity; then
            if [[ "$NETWORK_STATUS" == "disconnected" ]]; then
                echo -e "\n\033[32m✓ 网络已恢复\033[0m"
                NETWORK_STATUS="connected"
                RECONNECT_ATTEMPTS=0
            fi
            NETWORK_STATUS="connected"
        else
            if [[ "$NETWORK_STATUS" == "connected" ]]; then
                echo -e "\n\033[33m⚠ 网络中断，尝试重连...\033[0m"
                NETWORK_STATUS="disconnected"
                handle_network_loss
            fi
        fi
    done
}

# 处理网络丢失
handle_network_loss() {
    NETWORK_STATUS="disconnected"
    PLAYER_STATUS="buffering"

    # 启动重连循环
    local attempt
    for attempt in $(seq 1 "$MAX_RECONNECT_ATTEMPTS"); do
        RECONNECT_ATTEMPTS=$attempt

        printf '\033[36m重连尝试 %d/%s...\033[0m\n' "$attempt" "$MAX_RECONNECT_ATTEMPTS"
        sleep "$RECONNECT_DELAY"

        if check_connectivity; then
            printf '\033[32m✓ 网络恢复，续播中...\033[0m\n'
            NETWORK_STATUS="connected"
            PLAYER_STATUS="playing"

            # 重新播放当前歌曲
            if [[ $PLAYLIST_INDEX -ge 0 ]] && [[ $PLAYLIST_INDEX -lt ${#PLAYLIST[@]} ]]; then
                do_play "$PLAYLIST_INDEX" --no-message
            fi
            return 0
        fi
    done

    printf '\033[31m✗ 重连失败 (已尝试 %s 次), 播放已停止\033[0m\n' "$MAX_RECONNECT_ATTEMPTS"
    do_stop
    return 1
}

# 启动网络监控
start_watchdog() {
    if [[ -z "$WATCHDOG_PID" ]] || ! kill -0 "$WATCHDOG_PID" 2>/dev/null; then
        network_watchdog &
        WATCHDOG_PID=$!
    fi
}

# 停止网络监控
stop_watchdog() {
    if [[ -n "$WATCHDOG_PID" ]]; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
        WATCHDOG_PID=""
    fi
}

#==============================================================================
# 播放控制 (基于 mpv JSON IPC 后端)
