#==============================================================================
# LX-Music-Shell 安装脚本钩子
#==============================================================================

# 安装后执行
post_install() {
    echo ">>> LX-Music-Shell 已安装"
    echo ""
    echo "运行方式:"
    echo "  lx-music-shell          # 交互模式"
    echo "  lx-music-shell --help   # 查看帮助"
    echo "  lx-music-shell --test-sources  # 测试源连通性"
    echo ""
    echo "配置文件位置: ~/.config/lx-music-shell/"
    echo ""
    echo "可选依赖:"
    echo "  mpv     - 默认播放器后端"
    echo "  mplayer - 替代播放器后端"
    echo "  ffmpeg  - ffplay 后端"
    echo "  jq      - JSON解析支持"
    echo ""
    echo "使用 yay/pacman 卸载:"
    echo "  sudo pacman -R lx-music-shell       # 仅删除包"
    echo "  sudo pacman -Rns lx-music-shell     # 删除包及其依赖"
}

# 升级后执行
post_upgrade() {
    post_install
}

# 卸载前执行
pre_remove() {
    # 尝试停止所有正在运行的 LX-Music-Shell 实例
    pkill -9 -f "lx-music-shell" 2>/dev/null || true
    pkill -9 mpv 2>/dev/null || true
    sleep 1
}

# 卸载后执行
post_remove() {
    echo ">>> LX-Music-Shell 已卸载"
    echo ""
    echo "系统文件已清理"
    echo ""
    echo "如需删除用户配置文件，请手动执行:"
    echo "  rm -rf ~/.config/lx-music-shell"
    echo "  rm -rf ~/.cache/lx-music-shell"
    echo "  rm -rf ~/.local/share/lx-music-shell"
    echo ""
    echo "完整清理（包括配置和下载的音乐）:"
    echo "  rm -rf ~/.config/lx-music-shell ~/.cache/lx-music-shell"
    echo "  rm -rf ~/.local/share/lx-music-shell"
    echo "  rm -rf ~/Music/LX-Music-Shell"
}